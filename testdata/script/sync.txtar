# ct sync against a fake Jira, three runs ($SYNCDATA/state<n>.json, built by
# fixtures.jq). Each must leave tickets/ and inbox/ as in
# $SYNCDATA/golden/run<n>: what the bash ticket-sync wrote for the same runs
# (UPDATE_GOLDEN=1 go test . rewrites them).
exec ct vault init demo --defaults
cp sources.json home/Documents/Obsidian/demo/tickets/.sources.json
mkdir home/Documents/Obsidian/demo/tickets/PROJ-12 home/Documents/Obsidian/demo/tickets/PROJ-13 home/Documents/Obsidian/demo/tickets/MAN-1
cp proj-12.md home/Documents/Obsidian/demo/tickets/PROJ-12/PROJ-12.md
cp proj-13.md home/Documents/Obsidian/demo/tickets/PROJ-13/PROJ-13.md
cp man-1.md home/Documents/Obsidian/demo/tickets/MAN-1/MAN-1.md
env CLAUDE_TICKETS_VAULT=$WORK/home/Documents/Obsidian/demo

# 1: every ticket new; a parent epic pulled in; a ticket that fails; HTML to Claude
fakejira $SYNCDATA/state1.json
! exec ct sync
stdout '^jira: open 11, new 10, to refresh 1, to close 0, gone 0, blocked flips 0, unchanged 0$'
stdout '^PROJ-12: nothing the note shows \(timestamp only\) \[In Progress\] Legacy note$'
stdout '^PROJ-16: couldn.t sync'
stdout '^PROJ-20: new \[In Progress\] Platform$'
stdout '2 HTML-only part\(s\) go to Claude'
stderr 'getJiraIssue failed: issue PROJ-16'
grep ' -p /tickets:ticket-sync jira --plan tickets/.sync-plan.json --followups tickets/.sync-followups --model sonnet --strict-mcp-config --permission-mode dontAsk --allowedTools mcp__atlassian,Read,Write,Edit,Glob,Grep,Bash\(date:\*\) --output-format stream-json --verbose$' calls/claude
grep '"id": "PROJ-2",\n *"part": "description"' calls/sync-plans
! exists home/Documents/Obsidian/demo/tickets/.sync-plan.json
grep '^-a ct sync -u critical ct sync: 1 ticket\(s\) failed' calls/notify-send
cmpvault home/Documents/Obsidian/demo $SYNCDATA/golden/run1

# 2: timestamp only, description + comments, truncated changelog, closed,
# reassigned, deleted, a blocked flip, an epic's children
fakejira $SYNCDATA/state2.json
exec ct sync
grep '^-a ct sync ct sync done' calls/notify-send
stdout '^jira: open 9, new 2, to refresh 6, to close 1, gone 1, blocked flips 1, unchanged 4$'
stdout '^PROJ-1: nothing the note shows \(timestamp only\)'
stdout '^PROJ-5: description; comments \[To Do\] Invoice PDF$'
stdout '^PROJ-3: assignee; no longer yours; comments \(HTML, to Claude\)'
stdout '^PROJ-4: children \[In Progress\] Billing v2$'
stdout '^PROJ-8: no longer found in Jira'
stdout '^PROJ-10: blocked: false'
cmpvault home/Documents/Obsidian/demo $SYNCDATA/golden/run2

# 3: a closed ticket reopened
fakejira $SYNCDATA/state3.json
exec ct sync
stdout '^PROJ-2: status; reopened \[In Progress\]'
stdout 'written without Claude'
cmpvault home/Documents/Obsidian/demo $SYNCDATA/golden/run3

# Sources: one at a time, sync: false, unknown, no mcp server
exec ct sync --source manual
stdout '.manual. has "sync": false'
! exec ct sync --source nope
stderr 'no source .nope.'
cp nomcp.json home/Documents/Obsidian/demo/tickets/.sources.json
! exec ct sync
stderr 'jira: no "mcp" server set'
grep '^-a ct sync -u critical ct sync: jira failed' calls/notify-send
# --full: Claude over everything (the skill's own listing)
cp sources.json home/Documents/Obsidian/demo/tickets/.sources.json
exec ct sync --full
grep ' -p /tickets:ticket-sync jira --followups tickets/.sync-followups --model sonnet' calls/claude

-- sources.json --
{"sources": {
  "manual": {"enabled": true, "sync": false, "idPrefix": "MAN"},
  "jira": {"enabled": true, "mcp": "atlassian", "idPrefix": "", "query": "assignee = currentUser() AND statusCategory != Done"},
  "zendesk": {"enabled": false, "mcp": "zendesk"}}}
-- nomcp.json --
{"sources": {"jira": {"enabled": true, "query": "x"}}}
-- proj-12.md --
---
title: PROJ-12
summary: Legacy note
status: in-progress
saved: 2026-07-30T09:00:00
ticket-type: dev
source: jira
source-id: PROJ-12
source-updated: 2026-08-01T10:00:00.000-0400
tags: [ticket, jira, proj]
---
# PROJ-12

Old notes, kept.

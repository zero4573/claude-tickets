mkdir home/Documents/Obsidian/a/.obsidian home/Documents/Obsidian/a/tickets/MAN-1 home/Projects/work-a/MAN-1
expand ws1.json
cp man-1.md home/Documents/Obsidian/a/tickets/MAN-1/MAN-1.md
cp ws1.json home/Projects/work-a/MAN-1/workspace.json
mkdir bin
cp $WORK/stub/editor bin/code
cp $WORK/stub/editor bin/ttt
chmod 755 bin/code
chmod 755 bin/ttt
env PATH=$WORK/bin:$PATH

# env set: it wins over ttt
env CLAUDE_TICKETS_EDITOR='code --new-window'
exec ct open MAN-1
grep 'MAN-1.code-workspace$' calls/editor
! grep 'repo-a' calls/editor
rm calls/editor

# no env, ttt on PATH: each worktree, then the vault folder
env CLAUDE_TICKETS_EDITOR=
exec ct open MAN-1
grep '/MAN-1/repo-a .*/MAN-1/repo-b .*/Obsidian/a/tickets/MAN-1$' calls/editor
rm calls/editor

# neither ttt nor env: code as before
rm bin/ttt
exec ct open MAN-1
grep 'MAN-1.code-workspace$' calls/editor
rm calls/editor

# no env, no ttt, no code: the error
rm bin/code
exec sh -c 'ln -s "$(command -v ct)" bin/ct'
env PATH=$WORK/bin
! exec ct open MAN-1
stderr 'editor .code. not found'

-- man-1.md --
---
summary: First
status: new
source: manual
---
-- ws1.json --
{"id": "MAN-1", "vault": "$WORK/home/Documents/Obsidian/a", "repos": [
  {"provider": "github", "owner": "me", "repo": "foo", "slug": "github-me-foo", "path": "$WORK/home/Projects/work-a/MAN-1/repo-a", "base": "main", "branch": "feature/MAN-1", "mode": "worktree"},
  {"provider": "github", "owner": "me", "repo": "bar", "slug": "github-me-bar", "path": "$WORK/home/Projects/work-a/MAN-1/repo-b", "base": "main", "branch": "feature/MAN-1", "mode": "worktree"}
]}

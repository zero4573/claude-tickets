# github-acme-plain
-- ws1.json --
{"id": "MAN-1", "vault": "$WORK/home/Documents/Obsidian/a", "repos": [
  {"provider": "github", "owner": "acme", "repo": "ledger", "slug": "github-acme-ledger", "path": "$WORK/home/Projects/work-a/MAN-1/ledger", "base": "main", "branch": "feature/MAN-1", "mode": "worktree", "targetVersion": null},
  {"provider": "github", "owner": "acme", "repo": "plain", "slug": "github-acme-plain", "path": "$WORK/home/Projects/work-a/MAN-1/plain", "base": "main", "branch": "feature/MAN-1", "mode": "worktree", "targetVersion": null}
]}
-- ws3.json --
{"id": "MAN-3", "vault": "$WORK/home/Documents/Obsidian/a", "repos": [
  {"provider": "github", "owner": "acme", "repo": "ledger", "slug": "github-acme-ledger", "path": "$WORK/home/Projects/work-a/MAN-3/ledger", "base": "main", "branch": "feature/MAN-3", "mode": "worktree", "targetVersion": null}
]}
-- ws2.json --
{"id": "MAN-2", "vault": "$WORK/home/Documents/Obsidian/a", "repos": [
  {"provider": "github", "owner": "acme", "repo": "ledger", "slug": "github-acme-ledger", "path": "$WORK/home/Projects/work-a/MAN-2/ledger", "base": "main", "branch": "feature/MAN-2", "mode": "worktree", "targetVersion": null}
]}

# tix spec promote: snapshots, the move, one version note per ticket, conflicts
env V=home/Documents/Obsidian/a
env W1=home/Projects/work-a/MAN-1
env W2=home/Projects/work-a/MAN-2
env N1=$V/projects/github-acme-ledger/spec-versions/github-acme-ledger-spec-MAN-1.md
env C1=$V/tickets/manual/MAN-1/specs/github-acme-ledger
env C2=$V/tickets/manual/MAN-2/specs/github-acme-ledger
env W3=home/Projects/work-a/MAN-3
env C3=$V/tickets/manual/MAN-3/specs/github-acme-ledger
mkdir $V/.obsidian $V/projects/github-acme-ledger/specs/posting $V/projects/github-acme-plain $W1 $W2 $C1/posting $C2/journal
cp man.md $V/tickets/manual/MAN-1/MAN-1.md
cp man.md $V/tickets/manual/MAN-2/MAN-2.md
cp ledger.md $V/projects/github-acme-ledger/github-acme-ledger.md
cp plain.md $V/projects/github-acme-plain/github-acme-plain.md
cp posting.md $V/projects/github-acme-ledger/specs/posting/spec.md
expand ws1.json ws2.json
cp ws1.json $W1/workspace.json
cp ws2.json $W2/workspace.json

# the help describes the transaction and points at the doc
exec tix spec promote --help
stdout '^  conflict check: '
stdout '^  plan and stage: '
stdout '^  commit point: the journal specs-stage/<slug>\.journal'
stdout '^  apply: base, kept list, the copy.s files kept as theirs to \.trash/, note,'
stdout 'finished by the next tix spec\s+promote \(before any other check of any repo\) or tix spec start'
stdout 'takes the vault lock for it'
stdout 'holds that file back'
stdout 'specs-after/\.<slug>\.kept'
stdout 'docs/spec-versions\.md'

# nothing in the copy yet: nothing to promote, nothing written; repos without vault specs are skipped
exec tix spec promote MAN-1
stdout '^github-acme-ledger: nothing to promote$'
! stdout plain
! exists $V/tickets/manual/MAN-1/specs-base

# a copy made without tix spec start has no snapshot: refused before anything is written
cp p1-new.md $C1/posting/spec.md
! exec tix spec promote MAN-1
stderr 'github-acme-ledger: the copy tickets/manual/MAN-1/specs/github-acme-ledger/ has no snapshot tickets/manual/MAN-1/specs-base/github-acme-ledger/: run tix spec start MAN-1 github-acme-ledger first'
! exists $V/tickets/manual/MAN-1/specs-base
! exists $V/projects/github-acme-ledger/spec-versions
cmp $V/projects/github-acme-ledger/specs/posting/spec.md posting.md
# with --json the refusal is in the output too, so stdout alone never reads as nothing to promote
! exec tix spec promote --json MAN-1
stdout '"error": "github-acme-ledger: the copy tickets/manual/MAN-1/specs/github-acme-ledger/ has no snapshot'
stdout '"repos": \[\]'
# an error before the run is in the JSON too
! exec tix spec promote --json --resolve nosuch=ours MAN-1
stdout '"error": "--resolve nosuch: not a repo of MAN-1'
stdout '"repos": \[\]'
! exists $V/tickets/manual/MAN-1/specs-base
rm $C1/posting/spec.md

# both tickets start: the snapshots of projects/ promote compares against
exec tix spec start MAN-1 github-acme-ledger
stdout 'snapshot tickets/manual/MAN-1/specs-base/github-acme-ledger/ taken'
exec tix spec start MAN-2 github-acme-ledger

# MAN-2 promotes a new capability first
cp journal.md $C2/journal/spec.md
exec tix spec promote MAN-2
stdout '^github-acme-ledger: promoted 1 files \(journal\); version projects/github-acme-ledger/spec-versions/github-acme-ledger-spec-MAN-2.md$'
cmp $V/projects/github-acme-ledger/specs/journal/spec.md journal.md
! exists $V/tickets/manual/MAN-2/specs-base/github-acme-ledger/journal/spec.md
cmp $V/tickets/manual/MAN-2/specs-after/github-acme-ledger/journal/spec.md journal.md

# a clean promote: base, move, after, version note
cp p1-new.md $C1/posting/spec.md
exec tix spec promote MAN-1
stdout '^github-acme-ledger: promoted 1 files \(posting\); version projects/github-acme-ledger/spec-versions/github-acme-ledger-spec-MAN-1.md$'
cmp $V/tickets/manual/MAN-1/specs-base/github-acme-ledger/posting/spec.md posting.md
! exists $V/tickets/manual/MAN-1/specs-base/github-acme-ledger/journal/spec.md
cmp $V/tickets/manual/MAN-1/specs-after/github-acme-ledger/posting/spec.md p1-new.md
cmp $V/projects/github-acme-ledger/specs/posting/spec.md p1-new.md
! exists $C1/posting/spec.md
grep '^type: spec-version$' $N1
grep '^ticket: "\[\[MAN-1\]\]"$' $N1
grep '^files: \[posting/spec.md\]$' $N1
grep '^branch: feature/MAN-1$' $N1
grep '^promoted: 20\d\d-\d\d-\d\dT\d\d:\d\d:\d\d$' $N1
grep '^commit: ""$' $N1
grep '^Unpinned: promoted, not pushed yet$' $N1
grep '^- posting: \[\[tickets/manual/MAN-1/specs-base/github-acme-ledger/posting/spec\|before\]\] · \[\[tickets/manual/MAN-1/specs-after/github-acme-ledger/posting/spec\|after\]\]$' $N1
grep '^### REQ-LED-2 · Reverse$' $N1

# a repeat save: base kept, files accumulate, the same one note
mkdir $C1/journal $C1/posting
cp p1-v2.md $C1/posting/spec.md
cp journal.md $C1/journal/spec.md
exec tix spec promote MAN-1
stdout '^github-acme-ledger: promoted 2 files \(journal, posting\); version projects/github-acme-ledger/spec-versions/github-acme-ledger-spec-MAN-1.md$'
cmp $V/tickets/manual/MAN-1/specs-base/github-acme-ledger/posting/spec.md posting.md
cmp $V/projects/github-acme-ledger/specs/posting/spec.md p1-v2.md
grep '^files: \[journal/spec.md, posting/spec.md\]$' $N1
exec ls $V/projects/github-acme-ledger/spec-versions
cmp stdout versions.txt
exec tix spec promote MAN-1
stdout '^github-acme-ledger: nothing to promote$'
exec tix spec diff MAN-1
stdout '^  added REQ-LED-2 · Reverse \(posting, proposed\)$'
stdout '^  status REQ-LED-1 · Post \(posting, proposed -> implemented\)$'

# a clash: MAN-2 changes posting, which MAN-1 changed since MAN-2's snapshot
mkdir $C2/posting
cp p2-clash.md $C2/posting/spec.md
! exec tix spec promote MAN-2
stdout '^github-acme-ledger: refused: another ticket changed posting/spec.md in projects/github-acme-ledger/specs/ since this ticket''s snapshot$'
stdout '^  changed by: MAN-1 \(projects/github-acme-ledger/spec-versions/github-acme-ledger-spec-MAN-1.md, promoted 20\d\d-\d\d-\d\dT\d\d:\d\d:\d\d\)$'
stdout '^  theirs \(projects/\):$'
stdout '^    status REQ-LED-1 · Post \(posting, proposed -> implemented\)$'
stdout '^    added REQ-LED-2 · Reverse \(posting, proposed\)$'
stdout '^  ours \(the ticket''s copy\):$'
stdout '^    changed REQ-LED-1 · Post \(posting\)$'
stdout '^    added REQ-LED-9 · Batch \(posting, proposed\)$'
stdout '^  clash: posting \(posting/spec.md\): both changed REQ-LED-1$'
stdout '^  resolve: after merging into tickets/manual/MAN-2/specs/github-acme-ledger/, re-run with --resolve github-acme-ledger=merged,$'
stdout '--resolve github-acme-ledger=theirs'
! stdout 'MAN-2 \('
cmp $C2/posting/spec.md p2-clash.md
cmp $V/projects/github-acme-ledger/specs/posting/spec.md p1-v2.md
! exists $V/tickets/manual/MAN-2/specs-after/github-acme-ledger/posting/spec.md
# the same as data
! exec tix spec promote --json MAN-2
stdout '"ticket": "MAN-2"'
stdout '"status": "refused"'
stdout '"files": \[\s*"posting/spec.md"\s*\]'
stdout '"ticket": "MAN-1",\s*"note": "projects/github-acme-ledger/spec-versions/github-acme-ledger-spec-MAN-1.md"'
stdout '"theirs": \{'
stdout '"ours": \{'
stdout '"capability": "posting",\s*"file": "posting/spec.md",\s*"requirements": \[\s*"REQ-LED-1"\s*\],\s*"interfaces": false'
cmp $C2/posting/spec.md p2-clash.md

# bad --resolve values change nothing
! exec tix spec promote --resolve github-acme-ledger=mine MAN-2
stderr 'want <slug>=theirs, <slug>=ours or <slug>=merged'
! exec tix spec promote --resolve github-acme-other=ours MAN-2
stderr 'github-acme-other: not a repo of MAN-2 with its specs in the vault'
exists $C2/posting/spec.md

# keep theirs, mixed with a file that moves: the copy's conflicting file
# goes, projects/ stays, the snapshot moves on by theirs too
mkdir $C2/journal
cp journal.md $C2/journal/spec.md
exec tix spec promote --resolve github-acme-ledger=theirs MAN-2
stdout '^github-acme-ledger: kept theirs for posting/spec.md$'
stdout '^github-acme-ledger: promoted 1 files \(journal\); '
cmp $V/tickets/manual/MAN-2/specs-after/github-acme-ledger/posting/spec.md p1-v2.md
stdout '^github-acme-ledger: the copy.s files moved to .trash/MAN-2-spec-theirs/github-acme-ledger/$'
! exists $C2/posting/spec.md
cmp $V/.trash/MAN-2-spec-theirs/github-acme-ledger/posting/spec.md p2-clash.md
cmp $V/projects/github-acme-ledger/specs/posting/spec.md p1-v2.md
# the kept file's base moves onto theirs with the after, so a later change
# on top of theirs is measured from theirs
cmp $V/tickets/manual/MAN-2/specs-base/github-acme-ledger/posting/spec.md p1-v2.md
# the file kept as theirs stays in the after snapshot through a later
# promote of another file, so the change on top of theirs below still passes
exists $V/tickets/manual/MAN-2/specs-after/.github-acme-ledger.kept
grep '^posting/spec.md$' $V/tickets/manual/MAN-2/specs-after/.github-acme-ledger.kept
mkdir $C2/journal
cp journal-v2.md $C2/journal/spec.md
exec tix spec promote MAN-2
stdout '^github-acme-ledger: promoted 1 files \(journal\); '
cmp $V/tickets/manual/MAN-2/specs-after/github-acme-ledger/posting/spec.md p1-v2.md
cmp $V/tickets/manual/MAN-2/specs-after/github-acme-ledger/journal/spec.md journal-v2.md
grep '^files: \[journal/spec.md\]$' $V/projects/github-acme-ledger/spec-versions/github-acme-ledger-spec-MAN-2.md
# a change made on top of theirs is no conflict
mkdir $C2/posting
cp p2-ontheirs.md $C2/posting/spec.md
exec tix spec promote --json MAN-2
stdout '"status": "promoted"'
stdout '"capabilities": \[\s*"posting"\s*\]'
cmp $V/projects/github-acme-ledger/specs/posting/spec.md p2-ontheirs.md
cmp $V/tickets/manual/MAN-2/specs-base/github-acme-ledger/posting/spec.md p1-v2.md
# the version credits MAN-2 with its own change only, not MAN-1's under it
exec tix spec log github-acme-ledger
stdout '^       posting: \+REQ-LED-9$'
! stdout 'posting: REQ-LED-1 proposed→implemented \+REQ-LED-2 \+REQ-LED-9'

# keep ours: MAN-1 changes posting again after MAN-2 did; its copy replaces projects/
mkdir $C1/posting
cp p1-v3.md $C1/posting/spec.md
! exec tix spec promote MAN-1
stdout '^  changed by: MAN-2 '
stdout '^    added REQ-LED-9 · Batch \(posting, proposed\)$'
stdout '^    added REQ-LED-4 · Split \(posting, proposed\)$'
stdout '^  clash: posting \(posting/spec.md\): both changed the file, no requirement in common$'
exec tix spec promote --resolve github-acme-ledger=ours MAN-1
stdout '^github-acme-ledger: kept ours for posting/spec.md$'
stdout '^github-acme-ledger: promoted 1 files \(posting\); version '
cmp $V/projects/github-acme-ledger/specs/posting/spec.md p1-v3.md
cmp $V/tickets/manual/MAN-1/specs-after/github-acme-ledger/posting/spec.md p1-v3.md
cmp $V/tickets/manual/MAN-1/specs-base/github-acme-ledger/posting/spec.md posting.md
exec ls $V/projects/github-acme-ledger/spec-versions
cmp stdout versions.txt

# merged by hand: the copy is accepted as the merge on top of theirs
mkdir $C2/posting
cp p2-clash.md $C2/posting/spec.md
! exec tix spec promote MAN-2
stdout '--resolve github-acme-ledger=merged'
cp p1-v2.md $C2/posting/spec.md
! exec tix spec promote MAN-2
exec tix spec promote --resolve github-acme-ledger=merged MAN-2
stdout '^github-acme-ledger: kept merged for posting/spec.md$'
stdout '^github-acme-ledger: promoted 1 files \(posting\); version '
cmp $V/projects/github-acme-ledger/specs/posting/spec.md p1-v2.md
cmp $V/tickets/manual/MAN-2/specs-base/github-acme-ledger/posting/spec.md p1-v3.md
cmp $V/tickets/manual/MAN-2/specs-after/github-acme-ledger/posting/spec.md p1-v2.md
! exists $C2/posting/spec.md

# a copy that already holds theirs needs no flag
mkdir $C1/posting
cp p1-v2.md $C1/posting/spec.md
exec tix spec promote MAN-1
! stdout refused
stdout '^github-acme-ledger: promoted 1 files \(posting\); version '
cmp $V/projects/github-acme-ledger/specs/posting/spec.md p1-v2.md
cmp $V/tickets/manual/MAN-1/specs-base/github-acme-ledger/posting/spec.md p1-v2.md

# another ticket promotes a single file after this ticket's start: refused, however
# late this ticket's copy was written (no other copy file to date it by)
mkdir $W3 $V/tickets/manual/MAN-3
cp man.md $V/tickets/manual/MAN-3/MAN-3.md
expand ws3.json
cp ws3.json $W3/workspace.json
exec tix spec start MAN-3 github-acme-ledger posting
cmp $C3/posting/spec.md p1-v2.md
mkdir $C1/posting
cp p1-v3.md $C1/posting/spec.md
exec tix spec promote MAN-1
cmp $V/projects/github-acme-ledger/specs/posting/spec.md p1-v3.md
cp p2-clash.md $C3/posting/spec.md
! exec tix spec promote MAN-3
stdout 'refused: another ticket changed posting/spec.md'
stdout '^  changed by: MAN-1 '
cmp $C3/posting/spec.md p2-clash.md
cmp $V/projects/github-acme-ledger/specs/posting/spec.md p1-v3.md
cmp $V/tickets/manual/MAN-3/specs-base/github-acme-ledger/posting/spec.md p1-v2.md
! exists $V/tickets/manual/MAN-3/specs-after
exec tix spec promote --resolve github-acme-ledger=theirs MAN-3
stdout '^github-acme-ledger: nothing to promote$'
cmp $V/.trash/MAN-3-spec-theirs/github-acme-ledger/posting/spec.md p2-clash.md
! exists $C3/posting/spec.md
cmp $V/projects/github-acme-ledger/specs/posting/spec.md p1-v3.md

# a pending promote journal: diff and show refuse the ticket, log notes it,
# and the next start finishes it (here a note write that is already done)
mkdir $V/tickets/manual/MAN-1/specs-stage/github-acme-ledger
cp $N1 $V/tickets/manual/MAN-1/specs-stage/github-acme-ledger/note.md
cp journal.txt $V/tickets/manual/MAN-1/specs-stage/github-acme-ledger.journal
! exec tix spec diff MAN-1
stderr 'github-acme-ledger: promote pending: run tix spec promote MAN-1'
! exec tix spec show github-acme-ledger@MAN-1
stderr 'promote pending: run tix spec promote MAN-1'
exec tix spec log github-acme-ledger
stdout 'promote pending: run tix spec promote MAN-1'
exec tix spec diff MAN-2
exec tix spec start MAN-1 github-acme-ledger
! exists $V/tickets/manual/MAN-1/specs-stage
exec tix spec diff MAN-1
! stderr pending

# a stage left without a journal (a run stopped before its commit point) is deleted
mkdir $V/tickets/manual/MAN-1/specs-stage/github-acme-ledger/moves
exec tix spec promote MAN-1
stdout '^github-acme-ledger: nothing to promote$'
! exists $V/tickets/manual/MAN-1/specs-stage

# a replay never overwrites a projects/ file another ticket promoted after
# the stopped promote planned it: it holds the file back (here MAN-5's only
# file, so its note goes too) and the plan refuses it as a conflict;
# start replays the same way, under the vault lock
env W5=home/Projects/work-a/MAN-5
env C5=$V/tickets/manual/MAN-5/specs/github-acme-ledger
env S5=$V/tickets/manual/MAN-5/specs-stage/github-acme-ledger
mkdir $W5 $V/tickets/manual/MAN-5/specs-base/github-acme-ledger/posting
cp man.md $V/tickets/manual/MAN-5/MAN-5.md
expand ws5.json
cp ws5.json $W5/workspace.json
cp x0.md $V/tickets/manual/MAN-5/specs-base/github-acme-ledger/posting/spec.md
cp $V/projects/github-acme-ledger/specs/posting/spec.md theirs5.md
mkdir $C5/posting $S5/moves/posting $S5/after/posting $S5/prev/base/posting
cp mine.md $C5/posting/spec.md
cp mine.md $S5/moves/posting/spec.md
cp mine.md $S5/after/posting/spec.md
cp x0.md $S5/prev/base/posting/spec.md
cp absent5.txt $S5/prev/absent
cp note5.md $S5/note.md
cp journal5.txt $S5.journal
! exec tix spec promote MAN-5
stdout '^github-acme-ledger: finished the pending promote first:$'
stdout '^github-acme-ledger: held back posting/spec\.md: projects/ holds MAN-\d.s recorded after copy \(projects/github-acme-ledger/spec-versions/github-acme-ledger-spec-MAN-\d\.md\)$'
stdout '^github-acme-ledger: refused: another ticket changed posting/spec.md'
cmp $V/projects/github-acme-ledger/specs/posting/spec.md theirs5.md
cmp $C5/posting/spec.md mine.md
! exists $V/tickets/manual/MAN-5/specs-stage
! exists $V/projects/github-acme-ledger/spec-versions/github-acme-ledger-spec-MAN-5.md
mkdir $C5/posting $S5/moves/posting $S5/after/posting $S5/prev/base/posting
cp mine.md $C5/posting/spec.md
cp mine.md $S5/moves/posting/spec.md
cp mine.md $S5/after/posting/spec.md
cp x0.md $S5/prev/base/posting/spec.md
cp absent5.txt $S5/prev/absent
cp note5.md $S5/note.md
cp journal5.txt $S5.journal
exec tix spec start MAN-5 github-acme-ledger
stdout '^github-acme-ledger: held back posting/spec\.md: projects/ holds MAN-'
stdout '^run tix spec promote MAN-5 to resolve$'
cmp $V/projects/github-acme-ledger/specs/posting/spec.md theirs5.md
! exists $V/tickets/manual/MAN-5/specs-stage
! exists $V/tickets/manual/MAN-5/specs-after/github-acme-ledger/posting/spec.md
! exists $V/.vault.lock.d
! exec tix spec promote MAN-5
stdout '^github-acme-ledger: refused: another ticket changed posting/spec.md'
exec tix spec promote --resolve github-acme-ledger=theirs MAN-5
cmp $V/projects/github-acme-ledger/specs/posting/spec.md theirs5.md
cmp $V/.trash/MAN-5-spec-theirs/github-acme-ledger/posting/spec.md mine.md

# errors
! exec tix spec promote MAN-99
stderr 'no workspace for MAN-99'

-- x0.md --
x0
-- mine.md --
mine
-- absent5.txt --
after posting/spec.md
note projects/github-acme-ledger/spec-versions/github-acme-ledger-spec-MAN-5.md
-- note5.md --
---
type: spec-version
slug: github-acme-ledger
ticket: "[[MAN-5]]"
project: "[[github-acme-ledger]]"
promoted: 2026-01-01T00:00:00
files: [posting/spec.md]
branch: feature/MAN-5
commit: ""
pinned: ""
merged: ""
tags: []
---
# github-acme-ledger spec version MAN-5
-- journal5.txt --
promote-journal v2
write note projects/github-acme-ledger/spec-versions/github-acme-ledger-spec-MAN-5.md
replace-tree after
put posting/spec.md sha256:67645d09427281ee026a83646e517eb779e6fc5522e70a30c6970826f80e1ba2
drop posting/spec.md sha256:fcbc800db3f1867000b852f1ce0044b8f1584f76ade1ed6e65189824f95c3cda
-- ws5.json --
{"id": "MAN-5", "vault": "$WORK/home/Documents/Obsidian/a", "repos": [
  {"provider": "github", "owner": "acme", "repo": "ledger", "slug": "github-acme-ledger", "path": "$WORK/home/Projects/work-a/MAN-5/ledger", "base": "main", "branch": "feature/MAN-5", "mode": "worktree", "targetVersion": null}
]}
-- journal.txt --
promote-journal v2
write note projects/github-acme-ledger/spec-versions/github-acme-ledger-spec-MAN-1.md
-- versions.txt --
github-acme-ledger-spec-MAN-1.md
github-acme-ledger-spec-MAN-2.md

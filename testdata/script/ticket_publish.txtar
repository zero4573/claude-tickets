  {"provider": "github", "owner": "acme", "repo": "ledger", "slug": "github-acme-ledger", "path": "$WORK/home/Projects/work-a/PROJ-2/ledger", "base": "main", "branch": "feature/PROJ-2", "mode": "worktree", "targetVersion": null}

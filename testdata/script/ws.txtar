# tix ws against real git: a "remote" (a bare repo standing in for
# git@github.com:acme/billing.git, through url.insteadOf) and the vault a
mkdir home/Documents/Obsidian/a/.obsidian home/Documents/Obsidian/a/tickets/MAN-1
cp man-1.md home/Documents/Obsidian/a/tickets/MAN-1/MAN-1.md
mkdir home/Documents/Obsidian/a/tickets/MAN-2
cp man-2.md home/Documents/Obsidian/a/tickets/MAN-2/MAN-2.md
expand gitconfig
exec git init -q -b main seed
exec git -C seed add -A
exec git -C seed commit -q -m init
exec git clone -q --bare seed remote/acme/billing.git
exec git -C seed remote add origin $WORK/remote/acme/billing.git

# clone: into ~/Projects/<provider>/<owner>/<repo>
exec tix ws clone github/acme/billing
stdout 'cloned github/acme/billing \(slug github-acme-billing\)'
exists home/Projects/repo-a/github/acme/billing/.git
exec tix ws clone github/acme/billing
stdout 'already cloned'
# a pre-existing directory is never touched, even when git clone fails
mkdir home/Projects/repo-a/github/acme/half
cp env home/Projects/repo-a/github/acme/half/notes.txt
! exec tix ws clone github/acme/half
stderr 'exists and is not a clone'
exists home/Projects/repo-a/github/acme/half/notes.txt
# a URL that climbs out of provider/owner/repo is refused
! exec tix ws clone --url git@bitbucket.org:keep/..
stderr 'tell provider/owner/repo'
exists home/Projects/repo-a/github/acme/billing/.git
# an owner folder symlinked out of the projects root is refused
mkdir outside
symlink home/Projects/repo-a/github/evil -> $WORK/outside
! exec tix ws clone github/evil/billing
stderr 'outside '
! exists outside/billing
rm home/Projects/repo-a/github/evil
# a provider folder symlinked out: nothing is created behind it
symlink home/Projects/repo-a/gitlab -> $WORK/outside
! exec tix ws clone gitlab/evil/billing --url git@gitlab.com:evil/billing.git
stderr 'outside .*home.Projects.repo-a'
! exists outside/evil
rm home/Projects/repo-a/gitlab
# a vault whose workRoot sits inside its projectsRoot is refused
cp nested-workflow.json home/Documents/Obsidian/a/.workflow.json
! exec tix ws clone github/acme/other
stderr 'workRoot .* is inside projectsRoot'
! exists home/Projects/repo-a/github/acme/other
rm home/Documents/Obsidian/a/.workflow.json
! exec tix ws clone gitlab/acme/billing
stderr 'no default URL for provider .gitlab.'
exec tix ws repos
stdout '^SLUG +REPO$'
stdout '^github-acme-billing +github/acme/billing$'

# add: a worktree on feature/<ID>-<desc>, with the .worktreeinclude files
cp env home/Projects/repo-a/github/acme/billing/.env
exec tix ws add MAN-1 github-acme-billing --base main --desc 'Fix the Thing' --version 2.1
stdout 'created .*/work-a/MAN-1/github-acme-billing \(worktree\) on feature/fix-the-thing \(from origin/main\)'
exists home/Projects/work-a/MAN-1/github-acme-billing/.env
grep '"branch": "feature/fix-the-thing"' home/Projects/work-a/MAN-1/workspace.json
grep '"mode": "worktree"' home/Projects/work-a/MAN-1/workspace.json
grep '"targetVersion": "2.1"' home/Projects/work-a/MAN-1/workspace.json
grep '"id": "MAN-1"' home/Projects/work-a/MAN-1/workspace.json
exec tix ws add MAN-1 github/acme/billing --base main
stdout 'already exists \(branch feature/fix-the-thing\)'
# the version is kept when not given again
grep '"targetVersion": "2.1"' home/Projects/work-a/MAN-1/workspace.json
# a manual ticket's branch needs --desc (or --branch)
! exec tix ws add MAN-5 github-acme-billing --base main
stderr 'a manual ticket.s branch needs --desc \(or --branch\)'
! exists home/Projects/work-a/MAN-5/github-acme-billing
# two manual tickets can't share one branch name by accident
! exec tix ws add MAN-5 github-acme-billing --base main --desc 'Fix the Thing'
stderr 'branch .feature/fix-the-thing. is already used by MAN-1'
! exists home/Projects/work-a/MAN-5/github-acme-billing
! exec tix ws add MAN-1 nope --base main
stderr 'no main clone .nope.'
! exec tix ws add MAN-1 github-acme-billing
stderr '--base <branch> is required'
! exec tix ws add man-1 github-acme-billing --base main
stderr 'not a ticket ID'
! exec tix ws add MAN-3 github-acme-billing --base nope --desc x
stderr 'base branch .nope. not found'

# ls and diff: a commit and an untracked file
cp change.txt home/Projects/work-a/MAN-1/github-acme-billing/change.txt
exec git -C home/Projects/work-a/MAN-1/github-acme-billing add change.txt
exec git -C home/Projects/work-a/MAN-1/github-acme-billing commit -q -m change
cp change.txt home/Projects/work-a/MAN-1/github-acme-billing/untracked.txt
exec tix ws ls
stdout '^TICKET +REPO +BRANCH +BASE +CHANGED +AHEAD +BEHIND$'
stdout '^MAN-1 +github-acme-billing +feature/fix-the-thing +main +1 +1 +0$'
exec tix ws diff MAN-1 --stat
stdout '^=== github-acme-billing \(feature/fix-the-thing vs main\) ===$'
stdout 'change.txt \| 1 \+'
stdout '^--- untracked files:$'
stdout '^untracked.txt$'

# never a second copy of the repo: a main clone whose .git isn't writable is refused
env TIX_WS_SHARED_CLONE=1
! exec tix ws add MAN-2 github-acme-billing --base main
stderr 'billing.\.git isn.t writable here, so no worktree can be made; run tix ws add on the host, or restart the session \(tix start MAN-2\)'
! exists home/Projects/work-a/MAN-2/github-acme-billing
env TIX_WS_SHARED_CLONE=

# an older workspace's shared clone (mode "clone") is still fetched and removed
exec git clone -q --shared --no-checkout home/Projects/repo-a/github/acme/billing home/Projects/work-a/MAN-2/github-acme-billing
exec git -C home/Projects/work-a/MAN-2/github-acme-billing checkout -q --no-track -B feature/MAN-2 origin/main
exec git -C home/Projects/work-a/MAN-2/github-acme-billing remote set-url origin git@github.com:acme/billing.git
expand ws-man-2.json
cp ws-man-2.json home/Projects/work-a/MAN-2/workspace.json

# fetch passes new commits on origin to the shared clones
cp change.txt seed/second.txt
exec git -C seed add second.txt
exec git -C seed commit -q -m second
exec git -C seed push -q origin main
exec tix ws fetch
stderr 'fetching 1 repo\(s\)'
exec git -C home/Projects/work-a/MAN-2/github-acme-billing log --format=%s origin/main
stdout '^second$'
exec tix ws ls MAN-1
stdout '^MAN-1 +github-acme-billing +feature/fix-the-thing +main +1 +1 +1$'
! exec tix ws fetch nope
stderr 'no main clone .nope.'

# rm: refuses uncommitted changes, and unpushed commits in a shared clone
! exec tix ws rm MAN-1
stderr 'github-acme-billing not removed'
stderr 'untracked files: untracked.txt'
exists home/Projects/work-a/MAN-1/workspace.json
rm home/Projects/work-a/MAN-1/github-acme-billing/untracked.txt
# the Go module cache (read-only folders, as go leaves them) goes too
mkdir home/Projects/work-a/MAN-1/.cache/go/pkg/mod/example.com/m@v1/sub
chmod 0555 home/Projects/work-a/MAN-1/.cache/go/pkg/mod/example.com/m@v1
# the .env the add seeded is unchanged: rm goes on; a changed one, or another ignored file, stops it
cp change.txt home/Projects/work-a/MAN-1/github-acme-billing/.env
! exec tix ws rm MAN-1
stderr 'ignored files that removing it would delete: \.env \('
cp env home/Projects/work-a/MAN-1/github-acme-billing/.env
cp env home/Projects/work-a/MAN-1/github-acme-billing/other.env
cp exclude-other home/Projects/repo-a/github/acme/billing/.git/info/exclude
! exec tix ws rm MAN-1
stderr 'ignored files that removing it would delete: other\.env \('
! stderr 'delete: \.env'
exists home/Projects/work-a/MAN-1/github-acme-billing/.env
rm home/Projects/work-a/MAN-1/github-acme-billing/other.env
cp env home/Projects/work-a/MAN-1/github-acme-billing/.env
exec tix ws rm MAN-1
! stdout 'ignored files removed'
stdout 'removed .*/MAN-1/github-acme-billing \(branch feature/fix-the-thing kept\)'
stdout 'removed workspace .*/work-a/MAN-1$'
! exists home/Projects/work-a/MAN-1
exec git -C home/Projects/repo-a/github/acme/billing rev-parse --verify -q refs/heads/feature/fix-the-thing
# the branch is picked up again
exec tix ws add MAN-1 github-acme-billing --base main --desc 'Fix the Thing'
stdout 'on existing branch feature/fix-the-thing'

# work on another branch counts too, not only the checked-out one
exec git -C home/Projects/work-a/MAN-2/github-acme-billing checkout -q -b side
cp change.txt home/Projects/work-a/MAN-2/github-acme-billing/side.txt
exec git -C home/Projects/work-a/MAN-2/github-acme-billing add side.txt
exec git -C home/Projects/work-a/MAN-2/github-acme-billing commit -q -m side
exec git -C home/Projects/work-a/MAN-2/github-acme-billing checkout -q feature/MAN-2
! exec tix ws rm MAN-2
stderr 'commits that aren.t on origin or stashed changes: [0-9a-f]+ side'
exists home/Projects/work-a/MAN-2/github-acme-billing/.git

cp change.txt home/Projects/work-a/MAN-2/github-acme-billing/mine.txt
exec git -C home/Projects/work-a/MAN-2/github-acme-billing add mine.txt
exec git -C home/Projects/work-a/MAN-2/github-acme-billing commit -q -m mine
! exec tix ws rm MAN-2
stderr 'commits that aren.t on origin or stashed changes: .*mine'
# --force never skips unpushed work: push it, then rm goes on
! exec tix ws rm MAN-2 --force
stderr 'commits that aren.t on origin'
exec git -C home/Projects/work-a/MAN-2/github-acme-billing push -q origin side feature/MAN-2
exec tix ws rm MAN-2
stdout 'removed .*/MAN-2/github-acme-billing \(shared clone\)'
! exists home/Projects/work-a/MAN-2

! exec tix ws rm MAN-9
stderr 'no workspace at'

# --force doesn't remove a dirty worktree
cp change.txt home/Projects/work-a/MAN-1/github-acme-billing/dirty.txt
! exec tix ws rm MAN-1
stderr 'untracked files: dirty.txt'
! exec tix ws rm MAN-1 --force
stderr 'untracked files: dirty.txt'
rm home/Projects/work-a/MAN-1/github-acme-billing/dirty.txt
exec tix ws rm MAN-1
! exists home/Projects/work-a/MAN-1

# once MAN-1's workspace is gone, its manual branch name is free again
exec tix ws add MAN-5 github-acme-billing --base main --desc 'Fix the Thing'
grep '"branch": "feature/fix-the-thing"' home/Projects/work-a/MAN-5/workspace.json

# rm sees untracked files whatever status.showUntrackedFiles says
exec tix ws add MAN-6 github-acme-billing --base main --desc six
env W=home/Projects/work-a/MAN-6/github-acme-billing
cp change.txt $W/untracked.txt
exec git -C $W config status.showUntrackedFiles no
! exec tix ws rm MAN-6
stderr 'github-acme-billing not removed'
stderr 'untracked files: untracked.txt \(commit or stash them\)'
! stderr 'submodule'
exists $W/untracked.txt
exec git -C $W config --unset status.showUntrackedFiles
rm $W/untracked.txt

# rm keeps a worktree with a submodule checked out: tix's status doesn't
# look inside it, and its git dir goes with the worktree
exec git -C $W submodule add -q git@github.com:acme/billing.git lib
exec git -C $W -c user.name=a -c user.email=a@example.com commit -q -m lib
cp change.txt $W/lib/new.txt
exec git -C $W/lib add new.txt
exec git -C $W/lib -c user.name=a -c user.email=a@example.com commit -q -m new
cp change.txt $W/lib/untracked.txt
! exec tix ws rm MAN-6
stderr 'a submodule checked out at lib, whose work tix doesn.t check \(check it by hand\)'
! stderr 'modified files'
exists $W/lib/untracked.txt
exec git -C $W rm -q --cached lib
exec git -C $W -c user.name=a -c user.email=a@example.com commit -q -m 'no gitlink'
cp exclude-lib home/Projects/repo-a/github/acme/billing/.git/info/exclude
! exec tix ws rm MAN-6
stderr 'a submodule checked out at .*[/\\]modules[/\\]lib, whose'
# nothing forces past a submodule: its git dir is removed by hand
! exec tix ws rm MAN-6 --force
stderr 'a submodule checked out'
rm home/Projects/repo-a/github/acme/billing/.git/worktrees/github-acme-billing1/modules
exec tix ws rm MAN-6 --drop-ignored
stdout 'removed .*/MAN-6/github-acme-billing \(branch feature/six kept\); ignored files removed with it: lib/'
! exists $W

# so does one with a nested repository committed as a gitlink
exec tix ws add MAN-7 github-acme-billing --base main --desc seven
env W=home/Projects/work-a/MAN-7/github-acme-billing
exec git init -q $W/inner
exec git -C $W/inner -c user.name=a -c user.email=a@example.com commit -q --allow-empty -m x
exec git -C $W add inner
exec git -C $W -c user.name=a -c user.email=a@example.com commit -q -m inner
! exec tix ws rm MAN-7
stderr 'a submodule checked out at inner,'
rm $W/inner/.git
# a repository in an ignored folder: rm refuses, naming it and its unpushed commits
mkdir $W/lib
exec git init -q $W/lib/inner
exec git -C $W/lib/inner -c user.name=a -c user.email=a@example.com commit -q --allow-empty -m nestedwork
! exec tix ws rm MAN-7
stderr 'ignored folders that hold a git repository: lib/inner/ \(unpushed: [0-9a-f]+ nestedwork\)'
exists $W/lib/inner/.git
# --drop-ignored moves it whole to the trash (the .env check below comes after)
exec tix ws rm MAN-7 --drop-ignored
stdout 'nested repositories moved to the trash: lib/inner/ -> .*/\.trash/MAN-7-ignored-files/github-acme-billing/lib/inner'
exists home/Documents/Obsidian/a/.trash/MAN-7-ignored-files/github-acme-billing/lib/inner/.git
! exists $W
exec tix ws add MAN-7 github-acme-billing --base main --desc seven
# a changed .env is the user's: rm names it and keeps the tree
cp change.txt $W/.env
! exec tix ws rm MAN-7
stderr 'ignored files that removing it would delete: \.env \(keep them, or use --drop-ignored\)'
exists $W/.env
exec tix ws rm MAN-7 --drop-ignored
stdout 'removed .*/MAN-7/github-acme-billing \(branch feature/seven kept\); ignored files removed with it: \.env$'

# a refusal lists every guard with its items: modified and untracked files, ignored ones
# (a seeded file inside an ignored folder counts as unchanged), nothing hidden by the flags
cp include-cfg home/Projects/repo-a/github/acme/billing/.worktreeinclude
cp exclude-cfg home/Projects/repo-a/github/acme/billing/.git/info/exclude
mkdir home/Projects/repo-a/github/acme/billing/cfg
cp env home/Projects/repo-a/github/acme/billing/cfg/a.txt
exec tix ws add MAN-10 github-acme-billing --base main --desc ten
env W=home/Projects/work-a/MAN-10/github-acme-billing
exists $W/cfg/a.txt
cp env $W/cfg/b.txt
cp change.txt $W/README.md
cp change.txt $W/new.txt
! exec tix ws rm MAN-10
stderr 'modified files: README.md \(commit or stash them\)'
stderr 'untracked files: new.txt \(commit or stash them\)'
stderr 'ignored files that removing it would delete: cfg/b.txt \('
! stderr 'cfg/a.txt'
! exec tix ws rm MAN-10 --drop-ignored
stderr 'modified files: README.md'
stderr 'untracked files: new.txt'
! stderr 'ignored files'
exists $W/cfg/b.txt
exec git -C $W checkout -- README.md
rm $W/new.txt
! exec tix ws rm MAN-10
stderr 'ignored files that removing it would delete: cfg/b.txt \('
! stderr 'modified files'
exec tix ws rm MAN-10 --drop-ignored
stdout 'ignored files removed with it: cfg/b.txt$'
! exists $W

# a shared clone with a changed ignored .env and an unpushed commit: both are named
exec git clone -q --shared --no-checkout home/Projects/repo-a/github/acme/billing home/Projects/work-a/MAN-11/github-acme-billing
exec git -C home/Projects/work-a/MAN-11/github-acme-billing checkout -q --no-track -B feature/MAN-11 origin/main
exec git -C home/Projects/work-a/MAN-11/github-acme-billing remote set-url origin git@github.com:acme/billing.git
expand ws-man-11.json
cp ws-man-11.json home/Projects/work-a/MAN-11/workspace.json
env C=home/Projects/work-a/MAN-11/github-acme-billing
cp change.txt $C/.env
cp change.txt $C/lonely.txt
exec git -C $C add lonely.txt
exec git -C $C commit -q -m lonely
! exec tix ws rm MAN-11
stderr 'ignored files that removing it would delete: \.env \('
stderr 'commits that aren.t on origin or stashed changes: [0-9a-f]+ lonely \(push them\)'
! exec tix ws rm MAN-11 --drop-ignored
stderr 'lonely'
! stderr 'ignored files'
exec git -C $C push -q origin feature/MAN-11
exec tix ws rm MAN-11 --drop-ignored
stdout 'removed .*/MAN-11/github-acme-billing \(shared clone\); ignored files removed with it: \.env$'

-- gitconfig --
# Trusted only because it is the user's global config (tix checks a repo's
# own config, never this): the local remotes stand in for real hosts
[protocol "file"]
	allow = always
[url "$WORK/remote/"]
	insteadOf = git@github.com:
[advice]
	detachedHead = false
-- nested-workflow.json --
{"projectsRoot": "~/Projects/repo-a", "workRoot": "~/Projects/repo-a/work"}
-- ws-man-2.json --
{
  "id": "MAN-2",
  "repos": [
    {
      "provider": "github",
      "owner": "acme",
      "repo": "billing",
      "slug": "github-acme-billing",
      "path": "$WORK/home/Projects/work-a/MAN-2/github-acme-billing",
      "base": "main",
      "branch": "feature/MAN-2",
      "mode": "clone"
    }
  ]
}
-- ws-man-11.json --
{
  "id": "MAN-11",
  "repos": [
    {
      "provider": "github",
      "owner": "acme",
      "repo": "billing",
      "slug": "github-acme-billing",
      "path": "$WORK/home/Projects/work-a/MAN-11/github-acme-billing",
      "base": "main",
      "branch": "feature/MAN-11",
      "mode": "clone"
    }
  ]
}
-- include-cfg --
.env
cfg/
-- exclude-cfg --
cfg/
-- man-1.md --
---
summary: First
status: in-progress
---
-- man-2.md --
---
source: jira
summary: Second
status: in-progress
---
-- env --
SECRET=1
-- exclude-other --
other.env
-- exclude-lib --
lib/
-- change.txt --
changed
-- seed/README.md --
# billing
-- seed/.gitignore --
.env
-- seed/.worktreeinclude --
.env

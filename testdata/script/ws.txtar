# ct ws against real git: a "remote" (a bare repo standing in for
# git@github.com:acme/billing.git, through url.insteadOf) and the vault a
mkdir home/Documents/Obsidian/a/.obsidian home/Documents/Obsidian/a/tickets/MAN-1
cp man-1.md home/Documents/Obsidian/a/tickets/MAN-1/MAN-1.md
expand gitconfig
exec git init -q -b main seed
exec git -C seed add -A
exec git -C seed commit -q -m init
exec git clone -q --bare seed remote/acme/billing.git
exec git -C seed remote add origin $WORK/remote/acme/billing.git

# clone: into ~/Projects/<provider>/<owner>/<repo>, then its graph
exec ct ws clone github/acme/billing
stdout 'cloned github/acme/billing \(slug github-acme-billing\)'
exists home/Projects/github/acme/billing/.git
grep 'sh -s -- github/acme/billing' calls/podman
exec ct ws clone github/acme/billing
stdout 'already cloned'
! exec ct ws clone gitlab/acme/billing
stderr 'no default URL for provider .gitlab.'
exec ct ws repos
stdout '^SLUG +REPO$'
stdout '^github-acme-billing +github/acme/billing$'

# add: a worktree on feature/<ID>-<desc>, with the .worktreeinclude files
cp env home/Projects/github/acme/billing/.env
exec ct ws add MAN-1 github-acme-billing --base main --desc 'Fix the Thing' --version 2.1
stdout 'created .*/work/a/MAN-1/github-acme-billing \(worktree\) on feature/MAN-1-fix-the-thing \(from origin/main\)'
exists home/work/a/MAN-1/github-acme-billing/.env
grep '"branch": "feature/MAN-1-fix-the-thing"' home/work/a/MAN-1/workspace.json
grep '"mode": "worktree"' home/work/a/MAN-1/workspace.json
grep '"targetVersion": "2.1"' home/work/a/MAN-1/workspace.json
grep '"id": "MAN-1"' home/work/a/MAN-1/workspace.json
exec ct ws add MAN-1 github/acme/billing --base main
stdout 'already exists \(branch feature/MAN-1-fix-the-thing\)'
# the version is kept when not given again
grep '"targetVersion": "2.1"' home/work/a/MAN-1/workspace.json
! exec ct ws add MAN-1 nope --base main
stderr 'no main clone .nope.'
! exec ct ws add MAN-1 github-acme-billing
stderr '--base <branch> is required'
! exec ct ws add man-1 github-acme-billing --base main
stderr 'not a ticket ID'
! exec ct ws add MAN-3 github-acme-billing --base nope
stderr 'base branch .nope. not found'

# ls and diff: a commit and an untracked file
cp change.txt home/work/a/MAN-1/github-acme-billing/change.txt
exec git -C home/work/a/MAN-1/github-acme-billing add change.txt
exec git -C home/work/a/MAN-1/github-acme-billing commit -q -m change
cp change.txt home/work/a/MAN-1/github-acme-billing/untracked.txt
exec ct ws ls
stdout '^TICKET +REPO +BRANCH +BASE +CHANGED +AHEAD +BEHIND$'
stdout '^MAN-1 +github-acme-billing +feature/MAN-1-fix-the-thing +main +1 +1 +0$'
exec ct ws diff MAN-1 --stat
stdout '^=== github-acme-billing \(feature/MAN-1-fix-the-thing vs main\) ===$'
stdout 'change.txt \| 1 \+'
stdout '^--- untracked files:$'
stdout '^untracked.txt$'

# a shared clone where the main clone's .git isn't writable
env CLAUDE_TICKETS_WS_SHARED_CLONE=1
exec ct ws add MAN-2 github-acme-billing --base main
stdout '\(clone\) on feature/MAN-2 \(from origin/main\)'
env CLAUDE_TICKETS_WS_SHARED_CLONE=
exec git -C home/work/a/MAN-2/github-acme-billing config remote.origin.url
stdout '^git@github.com:acme/billing.git$'
grep '"mode": "clone"' home/work/a/MAN-2/workspace.json

# fetch passes new commits on origin to the shared clones
cp change.txt seed/second.txt
exec git -C seed add second.txt
exec git -C seed commit -q -m second
exec git -C seed push -q origin main
exec ct ws fetch
stderr 'fetching 1 repo\(s\)'
exec git -C home/work/a/MAN-2/github-acme-billing log --format=%s origin/main
stdout '^second$'
exec ct ws ls MAN-1
stdout '^MAN-1 +github-acme-billing +feature/MAN-1-fix-the-thing +main +1 +1 +1$'
! exec ct ws fetch nope
stderr 'no main clone .nope.'

# rm: refuses uncommitted changes, and unpushed commits in a shared clone
! exec ct ws rm MAN-1
stderr 'github-acme-billing has uncommitted changes, not removing'
exists home/work/a/MAN-1/workspace.json
rm home/work/a/MAN-1/github-acme-billing/untracked.txt
mkdir home/work/a/MAN-1/github-acme-billing/graphify-out
exec ct ws rm MAN-1
stdout 'removed .*/MAN-1/github-acme-billing \(branch feature/MAN-1-fix-the-thing kept\)'
stdout 'removed workspace .*/work/a/MAN-1$'
! exists home/work/a/MAN-1
exec git -C home/Projects/github/acme/billing rev-parse --verify -q refs/heads/feature/MAN-1-fix-the-thing
# the branch is picked up again
exec ct ws add MAN-1 github-acme-billing --base main
stdout 'on existing branch feature/MAN-1-fix-the-thing'

cp change.txt home/work/a/MAN-2/github-acme-billing/mine.txt
exec git -C home/work/a/MAN-2/github-acme-billing add mine.txt
exec git -C home/work/a/MAN-2/github-acme-billing commit -q -m mine
! exec ct ws rm MAN-2
stderr 'commits that aren.t on origin'
exec ct ws rm MAN-2 --force
stdout 'removed .*/MAN-2/github-acme-billing \(shared clone\)'
! exists home/work/a/MAN-2

! exec ct ws rm MAN-9
stderr 'no workspace at'

-- gitconfig --
[url "$WORK/remote/"]
	insteadOf = git@github.com:
[advice]
	detachedHead = false
-- man-1.md --
---
summary: First
status: in-progress
---
-- env --
SECRET=1
-- change.txt --
changed
-- seed/README.md --
# billing
-- seed/.gitignore --
.env
graphify-out/
-- seed/.worktreeinclude --
.env

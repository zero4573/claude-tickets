# A session runs in this terminal, in the foreground: one ticket per ct
# start, from a terminal. What the session record says, who cleans it up,
# and how a recorded process counts for the other commands.
mkdir home/Documents/Obsidian/a/.obsidian home/Projects/repo-a
mkdir home/Documents/Obsidian/a/tickets/MAN-1 home/Documents/Obsidian/a/tickets/MAN-2 home/Documents/Obsidian/a/tickets/MAN-3 home/Documents/Obsidian/a/tickets/MAN-4 home/Documents/Obsidian/a/tickets/MAN-6 home/Documents/Obsidian/a/tickets/MAN-7 home/Documents/Obsidian/a/tickets/MAN-8
cp open.md home/Documents/Obsidian/a/tickets/MAN-1/MAN-1.md
cp ignored.md home/Documents/Obsidian/a/tickets/MAN-2/MAN-2.md
cp open.md home/Documents/Obsidian/a/tickets/MAN-3/MAN-3.md
cp done.md home/Documents/Obsidian/a/tickets/MAN-4/MAN-4.md
cp open.md home/Documents/Obsidian/a/tickets/MAN-6/MAN-6.md
cp open.md home/Documents/Obsidian/a/tickets/MAN-7/MAN-7.md
cp done.md home/Documents/Obsidian/a/tickets/MAN-8/MAN-8.md

# ct vault names no launcher
exec ct vault
! stdout 'launcher'
! stdout 'session'

# one ticket only, from a terminal: refused before anything
! exec ct-tty start --no-fetch MAN-1 MAN-2
stderr 'ct start takes one ticket \(got 2\): the session runs in this terminal; start the others from their own terminals'
! exec ct-tty feedback --no-fetch MAN-1 MAN-2
stderr 'ct feedback takes one ticket \(got 2\)'
! exec ct start --no-fetch MAN-1
stderr 'the session runs in this terminal, and this isn.t one \(stdin/stdout\); run it from a terminal$'
! exists home/Projects/work-a/MAN-1
! exists calls/claude

# one ticket (named twice): claude runs here, in its workspace, with no
# shell wrapper; ct becomes claude (exec), so the recorded PID is the
# session's own
exec ct-tty start --no-fetch MAN-1 MAN-1
stdout '^ct start: MAN-1 runs in this terminal; ct start MAN-1 later continues it$'
grep '^--plugin-dir .*/plugin --add-dir=.*/Obsidian/a --add-dir=.*/home/Projects/repo-a .*--mcp-config .*/MAN-1/.claude/graph-mcp.json --permission-mode auto /tickets:work-ticket MAN-1$' calls/claude
! grep 'read -rp' calls/claude
grep '/home/Projects/work-a/MAN-1$' calls/claude-cwd
grep '^CLAUDE_TICKETS_VAULT=.*/Obsidian/a$' calls/claude-env
grep '"id": "MAN-1"' home/Projects/work-a/MAN-1/workspace.json
grep '"pid": [0-9]+' home/Projects/work-a/MAN-1/.sessions.json
grep '"command": "start"' home/Projects/work-a/MAN-1/.sessions.json
samepid home/Projects/work-a/MAN-1
grep '"host": ' home/Projects/work-a/MAN-1/.sessions.json
grep '"proc": ' home/Projects/work-a/MAN-1/.sessions.json
grep '"started": "[0-9]{4}-' home/Projects/work-a/MAN-1/.sessions.json

# its .agent-state alone says it's running (no record to check): refused,
# unless --force (its terminal was closed)
cp state-working.json home/Projects/work-a/MAN-1/.agent-state
rm home/Projects/work-a/MAN-1/.sessions.json
! exec ct-tty start --no-fetch MAN-1
stderr 'MAN-1: its session looks running \(.agent-state: working at 2026-10-06T10:00:00-04:00\); it.s in the terminal where it was started. If it isn.t \(terminal closed\), ct start --force MAN-1'
exec ct-tty start --no-fetch --force MAN-1
stdout 'MAN-1 runs in this terminal'
! stdout 'continuing'
! grep ' --continue' calls/claude

# the recorded process has ended (the stub claude): a fresh .agent-state
# doesn't count (PIDs can't be checked inside a container)
[!container] exec ct-tty start --no-fetch MAN-1
[!container] stdout 'MAN-1 runs in this terminal'

# a live process: refused, even with --force
[!container] live-session home/Projects/work-a/MAN-1
[!container] ! exec ct-tty start --no-fetch --force MAN-1
[!container] stderr 'MAN-1: its session is running \(pid [0-9]+, started [0-9]{2}:[0-9]{2}\) in another terminal; continue there, or end it first'
[!container] ! exec ct-tty feedback --no-fetch MAN-1
[!container] stderr 'MAN-1: its session is running \(pid [0-9]+\) in another terminal; type /tickets:pr-feedback there'

# feedback: nothing is typed into a running session; else it runs here
rm home/Projects/work-a/MAN-1/.sessions.json
! exec ct-tty feedback --no-fetch MAN-1
stderr 'type /tickets:pr-feedback in that session.s terminal, or if it isn.t running, ct feedback --force MAN-1'
! exec ct-tty start --feedback --no-fetch MAN-1
stderr 'ct start --feedback --force MAN-1'
cp state-exited.json home/Projects/work-a/MAN-1/.agent-state
exec ct-tty feedback --no-fetch MAN-1
grep '--permission-mode auto /tickets:pr-feedback MAN-1$' calls/claude
! grep ' --continue' calls/claude
grep '"command": "feedback"' home/Projects/work-a/MAN-1/.sessions.json

# an ignored ticket is skipped
! exec ct-tty start --no-fetch MAN-2
stderr 'MAN-2: marked ignore: true \(not mine\), skipping'
! grep MAN-2 calls/claude

# no claude: it fails before saying it runs, or recording a session
env CLAUDE_TICKETS_CLAUDE=no-such-claude
! exec ct-tty start --no-fetch MAN-6
stderr '"no-such-claude": executable file not found'
! stdout 'runs in this terminal'
! exists home/Projects/work-a/MAN-6/.sessions.json
env CLAUDE_TICKETS_CLAUDE=

# ct ws rm deletes the session record with the other files ct owns
exec ct-tty start --no-fetch MAN-6
exists home/Projects/work-a/MAN-6/.sessions.json
exec ct ws rm MAN-6
! exists home/Projects/work-a/MAN-6

# ct start --list and ID completion (one ID)
exec ct start --list
stdout '^MAN-1\t'
exec ct __complete start ''
stdout '^MAN-1\t'
exec ct __complete start MAN-1 ''
! stdout 'MAN-'

# status: no WINDOW column, AGENT from .agent-state
rm home/Projects/work-a/MAN-1/.sessions.json
cp state-working.json home/Projects/work-a/MAN-1/.agent-state
mkdir home/Projects/work-a/MAN-3
expand ws3.json
cp ws3.json home/Projects/work-a/MAN-3/workspace.json
cp state-working.json home/Projects/work-a/MAN-3/.agent-state
exec touch -d '2 days ago' home/Projects/work-a/MAN-3/.agent-state
exec ct status
stdout '^Vault a \(sessions run in their own terminal\)$'
stdout '^TICKET +SOURCE +AGENT +STATUS +REPOS '
! stdout 'WINDOW'
stdout '^MAN-1 +manual +working +in-progress '
stdout '^MAN-3 +manual +working \(stale\) +in-progress '

# a live recorded process, with an old hook state: running, not stale
mkdir home/Projects/work-a/MAN-7
expand ws7.json
cp ws7.json home/Projects/work-a/MAN-7/workspace.json
cp state-idle.json home/Projects/work-a/MAN-7/.agent-state
exec touch -d '3 days ago' home/Projects/work-a/MAN-7/.agent-state
live-session home/Projects/work-a/MAN-7
exec ct status
stdout '^MAN-7 +manual +idle +in-progress '
! stdout 'MAN-7 .*stale'

# gc: a fresh, not exited .agent-state keeps a finished workspace (gc
# refuses to run inside a container)
mkdir home/Projects/work-a/MAN-4/graphify-out
expand ws4.json
cp ws4.json home/Projects/work-a/MAN-4/workspace.json
cp state-working.json home/Projects/work-a/MAN-4/.agent-state
exec touch -d '20 days ago' home/Projects/work-a/MAN-4/workspace.json
[!container] exec ct ws gc
[!container] ! stdout 'MAN-4'
[!container] exists home/Projects/work-a/MAN-4/graphify-out
[!container] exec touch -d '2 days ago' home/Projects/work-a/MAN-4/.agent-state
[!container] exec ct ws gc
[!container] stdout 'remove MAN-4 \(done\)'
[!container] ! exists home/Projects/work-a/MAN-4

# gc keeps a finished workspace whose recorded process is alive, even
# without any hook state
mkdir home/Projects/work-a/MAN-8/graphify-out
expand ws8.json
cp ws8.json home/Projects/work-a/MAN-8/workspace.json
exec touch -d '20 days ago' home/Projects/work-a/MAN-8/workspace.json
live-session home/Projects/work-a/MAN-8
[!container] exec ct ws gc
[!container] ! stdout 'MAN-8'
[!container] exists home/Projects/work-a/MAN-8/graphify-out

# config.json's old launcher key is ignored
mkdir home/.config/claude-tickets
cp config-launcher.json home/.config/claude-tickets/config.json
exec ct vault
! stdout 'launcher'
exec ct status
stdout '^Vault a \(sessions run in their own terminal\)$'

-- open.md --
---
summary: Open
status: in-progress
source: manual
---
-- ignored.md --
---
summary: Not mine
status: new
ignore: true
ignore-reason: not mine
---
-- done.md --
---
summary: Done
status: done
source: manual
---
-- ws3.json --
{"id": "MAN-3", "vault": "$WORK/home/Documents/Obsidian/a", "repos": []}
-- ws4.json --
{"id": "MAN-4", "vault": "$WORK/home/Documents/Obsidian/a", "repos": []}
-- ws7.json --
{"id": "MAN-7", "vault": "$WORK/home/Documents/Obsidian/a", "repos": []}
-- ws8.json --
{"id": "MAN-8", "vault": "$WORK/home/Documents/Obsidian/a", "repos": []}
-- state-working.json --
{"state": "working", "reason": "", "ts": "2026-10-06T10:00:00-04:00"}
-- state-exited.json --
{"state": "exited", "reason": "", "ts": "2026-10-06T11:00:00-04:00"}
-- state-idle.json --
{"state": "idle", "reason": "", "ts": "2026-10-06T10:00:00-04:00"}
-- config-launcher.json --
{"launcher": "other"}

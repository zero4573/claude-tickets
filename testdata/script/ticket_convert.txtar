-- gitconfig --
# Trusted only because it is the user's global config (tix checks a repo's
# own config, never this): the local remotes stand in for real hosts
[protocol "file"]
	allow = always
[url "$WORK/remote/"]
	insteadOf = git@github.com:
[advice]
	detachedHead = false
-- change.txt --
changed
-- seed/README.md --
# billing

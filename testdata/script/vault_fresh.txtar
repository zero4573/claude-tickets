# Freshness: notes ct writes are re-indexed by the command that wrote them;
# without an index nothing is created.
mkdir v/.obsidian
mkdir v/inbox
mkdir v/templates
cp ticket-manual.md v/templates/ticket-manual.md
mkdir v/knowledge-base
cp a.md v/inbox/a.md
cp b.md v/inbox/b.md
env CLAUDE_TICKETS_EMBEDDER=stub
env CLAUDE_TICKETS_VAULT=$WORK/v

# No index: writes leave no .ct behind.
stdin plain.txt
exec ct vault note set-section inbox/b.md Sec
! exists v/.ct
exec ct vault links move v inbox/a.md knowledge-base
! exists v/.ct
exec ct vault links move v knowledge-base/a.md inbox

exec ct vault index

# ct vault links move.
exec ct vault links move v inbox/a.md knowledge-base
exec ct vault index --json
stdout '"changed":0'
grep '"path":"knowledge-base/a.md"' v/.ct/index/notes.jsonl
! grep '"path":"inbox/a.md"' v/.ct/index/notes.jsonl

# ct vault note set-section.
stdin fresh.txt
exec ct vault note set-section inbox/b.md Sec
grep 'freshly written words' v/.ct/index/chunks.jsonl
exec ct vault index --json
stdout '"changed":0'

# A sync-style write: ct new.
exec ct new 'Fresh ticket'
exec ct vault index --json
stdout '"changed":0'
grep 'tickets/MAN-1/MAN-1.md' v/.ct/index/notes.jsonl

-- ticket-manual.md --
---
title: {{title}}
summary:
created: {{date}}
status: new
ticket-type: dev
priority:
source: manual
---
# {{title}}

## Description
-- plain.txt --
plain edit
-- fresh.txt --
freshly written words
-- a.md --
# A

Text of a.
-- b.md --
# B

## Sec

old words

# ct start: workspace, settings, trust, graph MCP, one tmux window per ticket
mkdir home/Documents/Obsidian/a/.obsidian home/Projects/repo-a/github/acme/x/.git
mkdir home/Documents/Obsidian/a/tickets/MAN-1 home/Documents/Obsidian/a/tickets/MAN-2 home/Documents/Obsidian/a/tickets/MAN-3
cp man-1.md home/Documents/Obsidian/a/tickets/MAN-1/MAN-1.md
cp man-2.md home/Documents/Obsidian/a/tickets/MAN-2/MAN-2.md
cp man-3.md home/Documents/Obsidian/a/tickets/MAN-3/MAN-3.md
expand user-settings.json
env CLAUDE_TICKETS_SESSION_SETTINGS=$WORK/user-settings.json

exec ct start --no-fetch MAN-1
stdout '^ct start: MAN-1 started in tickets-a -- ct attach MAN-1$'
grep '^new-session -d -s tickets-a -n MAN-1 -c .*/home/Projects/work-a/MAN-1 bash -c env CLAUDE_TICKETS_VAULT=.*/Obsidian/a claude --plugin-dir .*/plugin --add-dir=.*/Obsidian/a --add-dir=.*/home/Projects/repo-a --add-dir=.*/home/Projects/repo-a/github/acme/x/.git --add-dir=.*/graphify --mcp-config .*/MAN-1/.claude/graph-mcp.json --permission-mode auto ./tickets:work-ticket MAN-1.; echo; read -rp .Session ended' calls/tmux
grep '"id": "MAN-1"' home/Projects/work-a/MAN-1/workspace.json
grep '"vault": ".*/Obsidian/a"' home/Projects/work-a/MAN-1/workspace.json
grep '^- Ticket: `MAN-1` \(source: `manual`\)$' home/Projects/work-a/MAN-1/CLAUDE.md
grep 'ct ws sign MAN-1' home/Projects/work-a/MAN-1/CLAUDE.md
grep '^  --hard, or remove the ticket worktrees; the lead adds and removes task$' home/Projects/work-a/MAN-1/CLAUDE.md
grep '^  worktrees under `tasks/`.$' home/Projects/work-a/MAN-1/CLAUDE.md
grep '^- Workflow: this session is the PO, the one the user talks to. It runs one$' home/Projects/work-a/MAN-1/CLAUDE.md
grep '^  .tickets:lead. subagent, which plans the ticket in waves of task agents$' home/Projects/work-a/MAN-1/CLAUDE.md
grep 'through .relay.md.; .board.md. tracks the tasks' home/Projects/work-a/MAN-1/CLAUDE.md
grep '/tickets:po-refresh. checkpoints them' home/Projects/work-a/MAN-1/CLAUDE.md
grep 'board.md' home/Projects/work-a/MAN-1/CLAUDE.md
grep '^Run `/tickets:work-ticket MAN-1` to \(re\)start the workflow \(`ct start MAN-1`$' home/Projects/work-a/MAN-1/CLAUDE.md
grep '^opens a new conversation, which resumes from `board.md`; `ct start$' home/Projects/work-a/MAN-1/CLAUDE.md
# settings: the main clones and the cache are read-only, merged with the user's
grep '"Edit\(//.*/home/Projects/repo-a/\*\*\)"' home/Projects/work-a/MAN-1/.claude/settings.json
grep '"Write\(//.*/home/.cache/claude-tickets/\*\*\)"' home/Projects/work-a/MAN-1/.claude/settings.json
grep '"Bash\(git push:\*\)"' home/Projects/work-a/MAN-1/.claude/settings.json
grep '"defaultMode": "auto"' home/Projects/work-a/MAN-1/.claude/settings.json
# Go fetches and builds into the workspace's .cache, which searches skip
grep '"GOMODCACHE": ".*/home/Projects/work-a/MAN-1/.cache/go/pkg/mod"' home/Projects/work-a/MAN-1/.claude/settings.json
grep '"GOCACHE": ".*/home/Projects/work-a/MAN-1/.cache/go/build"' home/Projects/work-a/MAN-1/.claude/settings.json
grep '"GOPATH": ".*/home/Projects/work-a/MAN-1/.cache/go"' home/Projects/work-a/MAN-1/.claude/settings.json
grep '"MCP_TIMEOUT": "600000"' home/Projects/work-a/MAN-1/.claude/settings.json
# the merged code graph is brought up to date before the session starts
stderr 'MAN-1: bringing the merged code graph up to date'
grep '^run --rm --security-opt label=disable -v .*/home/Projects/work-a/MAN-1:.* localhost/claude-tickets-graphify:[0-9a-f]+ /opt/graphify/serve.sh --merge$' calls/podman
grep '^/.cache/$' home/Projects/work-a/MAN-1/.ignore
grep '^graphify-out/$' home/Projects/work-a/MAN-1/.ignore
grep '^- Go: `GOPATH`' home/Projects/work-a/MAN-1/CLAUDE.md
grep '"hasTrustDialogAccepted": true' home/.claude.json
grep '"keep": 1' home/.claude.json
grep '"command": ".*ct' home/Projects/work-a/MAN-1/.claude/graph-mcp.json
grep '"mcp",' home/Projects/work-a/MAN-1/.claude/graph-mcp.json

# open already: not another window; feedback is typed into it
cp windows tmux-windows
exec ct start --no-fetch MAN-1
stderr 'MAN-1: already has a window in tmux session .tickets-a., not starting another'
exec ct feedback --no-fetch MAN-1
stdout 'MAN-1 already open, sent /tickets:pr-feedback MAN-1 to its window'
grep '^send-keys -t =tickets-a:MAN-1 /tickets:pr-feedback MAN-1 Enter$' calls/tmux
rm tmux-windows

# a workspace that ran a session gets a new conversation; --continue continues it
cp state.json home/Projects/work-a/MAN-1/.agent-state
rm calls/tmux
exec ct start --no-fetch MAN-1
! stdout 'continuing'
! grep ' --continue' calls/tmux
exec ct start --no-fetch --continue MAN-1
stdout 'started in tickets-a \(continuing its last session\)'
grep 'new-session .* --permission-mode auto --continue ./tickets:work-ticket MAN-1.' calls/tmux

# a failed merge stops the start: no session without the graph
rm calls/tmux
cp man-1.md index-fail
! exec ct start --no-fetch MAN-1
stderr 'merging the code graph of .*/MAN-1 failed'
! exists calls/tmux
rm index-fail

# ignored, covered by an open lead, unknown
! exec ct start --no-fetch MAN-2
stderr 'MAN-2: marked ignore: true \(not mine\), skipping'
! exec ct start --no-fetch MAN-3
stderr 'MAN-3: covered by MAN-1, so it.s worked there: ct start MAN-1'
exec ct start --no-fetch --force MAN-3
stdout 'MAN-3 started'
! exec ct start MAN-1 MAN-9
stderr 'not a ticket of the a vault: MAN-9'
! exec ct start nope
stderr 'not a ticket ID'
! exec ct start
stderr 'name at least one ticket'

-- man-1.md --
---
summary: First
status: in-progress
source: manual
---
-- man-2.md --
---
summary: Second
status: new
ignore: true
ignore-reason: not mine
---
-- man-3.md --
---
summary: Third
status: new
covered-by: "[[MAN-1]]"
---
-- user-settings.json --
{"permissions": {"deny": ["Bash(git push:*)"], "defaultMode": "auto"}}
-- windows --
MAN-1
-- state.json --
{"state": "exited", "reason": "", "ts": "2026-10-01T10:00:00-04:00"}
-- home/.claude.json --
{"keep": 1, "projects": {}}

-- wavetest --
package acme

func TestW1Retry(t *testing.T) {}

func TestW12Other(t *testing.T) {}
-- wavetest-edited --
package acme

func TestW1Retry(t *testing.T) { t.Log("edited") }

func TestW12Other(t *testing.T) {}

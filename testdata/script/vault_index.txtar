# tix vault index: first build, incremental runs, deletes, --full, the
# keyword-only index and its one-time hint, a model change, a damaged index.
mkdir home/Documents/Obsidian/v/.obsidian
mkdir home/Documents/Obsidian/v/projects/acme
mkdir home/Documents/Obsidian/v/raw
mkdir home/Documents/Obsidian/v/archive
mkdir home/Documents/Obsidian/v/templates
cp acme.md home/Documents/Obsidian/v/projects/acme/acme.md
cp other.md home/Documents/Obsidian/v/other.md
cp other.md home/Documents/Obsidian/v/raw/skip.md
cp other.md home/Documents/Obsidian/v/archive/skip.md
cp other.md home/Documents/Obsidian/v/templates/skip.md
cp other.md home/Documents/Obsidian/v/.obsidian/skip.md

env TIX_EMBEDDER=stub

# First build: skipped folders are not indexed.
exec tix vault index
stdout '^indexed 2 notes: 2 changed, 0 removed, 3 chunks embedded \(stub\) in [0-9.]+s$'
exists home/Documents/Obsidian/v/.tix/.gitignore
exists home/Documents/Obsidian/v/.tix/index/meta.json
exists home/Documents/Obsidian/v/.tix/index/notes.jsonl
exists home/Documents/Obsidian/v/.tix/index/chunks.jsonl
exists home/Documents/Obsidian/v/.tix/index/vectors.f32
grep '"format":1,"model":"stub"' home/Documents/Obsidian/v/.tix/index/meta.json
grep '"dims":64' home/Documents/Obsidian/v/.tix/index/meta.json
grep '"notes":2,"chunks":3' home/Documents/Obsidian/v/.tix/index/meta.json
grep '"path":"projects/acme/acme.md","name":"acme"' home/Documents/Obsidian/v/.tix/index/notes.jsonl
grep '"links":\["other"\]' home/Documents/Obsidian/v/.tix/index/notes.jsonl
! grep 'skip' home/Documents/Obsidian/v/.tix/index/notes.jsonl

# Nothing changed: nothing embedded.
exec tix vault index
stdout '0 changed, 0 removed, 0 chunks embedded'
exec tix vault index --json
stdout '"changed":0,"chunks":3,"embedded":0,"keyword_only":false,"model":"stub","notes":2,"removed":0'

# Edit one note: only its changed chunk is embedded.
cp acme2.md home/Documents/Obsidian/v/projects/acme/acme.md
exec tix vault index
stdout '2 notes: 1 changed, 0 removed, 1 chunks embedded'

# Rewriting a note with the same content changes nothing.
cp acme2.md home/Documents/Obsidian/v/projects/acme/acme.md
exec tix vault index
stdout ' 0 changed'
stdout '0 chunks embedded'

# Delete a note.
rm home/Documents/Obsidian/v/other.md
exec tix vault index
stdout '1 notes: 0 changed, 1 removed'

# --full re-embeds everything.
exec tix vault index --full
stdout '2 chunks embedded'

# A vault named on the command line; bad flags are usage errors.
exec tix vault index v --chunk-tokens 128
stdout '2 chunks embedded'
! exec tix vault index --no-such-flag
stderr 'unknown flag'

# An unknown model is a usage error.
env TIX_EMBEDDER=
! exec tix vault index --model no-such-model
stderr 'unknown model'
env TIX_EMBEDDER=stub

# No model on an index with vectors: they are kept, new chunks get zero rows.
env TIX_EMBEDDER=none
cp acme3.md home/Documents/Obsidian/v/projects/acme/acme.md
exec tix vault index
stderr '^tix: no embedding model, keyword search only'
grep '"model":"stub"' home/Documents/Obsidian/v/.tix/index/meta.json
exists home/Documents/Obsidian/v/.tix/index/vectors.f32
env TIX_EMBEDDER=stub
exec tix vault index
stdout ' 0 changed'
stdout '1 chunks embedded'
env TIX_EMBEDDER=none

# No model, explicit rebuild: keyword-only index, the hint once.
rm home/Documents/Obsidian/v/.tix/index/model-hint
exec tix vault index --full
stdout 'keyword only'
stderr '^tix: no embedding model, keyword search only; on the host run: tix vault model fetch$'
grep '"model":"","model_sha256":"","dims":0' home/Documents/Obsidian/v/.tix/index/meta.json
! exists home/Documents/Obsidian/v/.tix/index/vectors.f32
exec tix vault index
! stderr 'no embedding model'
exec tix vault index --json
stdout '"keyword_only":true'

# The model comes back: full rebuild with vectors.
env TIX_EMBEDDER=stub
exec tix vault index
stdout '2 chunks embedded \(stub\)'
exists home/Documents/Obsidian/v/.tix/index/vectors.f32

# A damaged meta.json is rebuilt.
cp broken.json home/Documents/Obsidian/v/.tix/index/meta.json
exec tix vault index
stdout '2 chunks embedded'
grep '"format":1' home/Documents/Obsidian/v/.tix/index/meta.json

-- acme.md --
---
type: project
tags: [a]
---
# Acme

See [[other]] for more.

## Details

The first details.
-- acme2.md --
---
type: project
tags: [a]
---
# Acme

See [[other]] for more.

## Details

The edited details.
-- acme3.md --
---
type: project
tags: [a]
---
# Acme

See [[other]] for more.

## Details

The third details.
-- other.md --
# Other

Some other text.

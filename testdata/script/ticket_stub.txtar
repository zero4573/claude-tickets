# ct ticket stub: the note of a ticket just filed under the lead, in the synced
# layout, and the lead's covers.
exec ct vault init demo --defaults
cp sources.json home/Documents/Obsidian/demo/tickets/.sources.json
mkdir home/Documents/Obsidian/demo/tickets/manual/MAN-1 home/Documents/Obsidian/demo/tickets/jira/PROJ-3
cp man-1.md home/Documents/Obsidian/demo/tickets/manual/MAN-1/MAN-1.md
mkdir home/Documents/Obsidian/demo/tickets/manual/MAN-2
cp man-2.md home/Documents/Obsidian/demo/tickets/manual/MAN-2/MAN-2.md
cp proj-3.md home/Documents/Obsidian/demo/tickets/jira/PROJ-3/PROJ-3.md
env CLAUDE_TICKETS_VAULT=$WORK/home/Documents/Obsidian/demo

# refusals change nothing
! exec ct ticket stub PROJ-9 --covered-by MAN-1 --summary x
stderr '--source is required'
! exec ct ticket stub PROJ-9 --source jira --summary x
stderr '--covered-by'
! exec ct ticket stub PROJ-9 --source jira --covered-by MAN-1
stderr '--summary is required'
! exec ct ticket stub PROJ-9 --source jira --covered-by MAN-9 --summary x
stderr 'no note for MAN-9'
! exec ct ticket stub PROJ-3 --source jira --covered-by MAN-1 --summary x
stderr 'already has a note'
! exec ct ticket stub PROJ-9 --source manual --covered-by MAN-1 --summary x
stderr 'not a synced source'
! exists home/Documents/Obsidian/demo/tickets/jira/PROJ-9
grep '^covers: \["\[\[PROJ-2\]\]"\]$' home/Documents/Obsidian/demo/tickets/manual/MAN-1/MAN-1.md

# the stub
exec ct ticket stub PROJ-9 --source jira --covered-by MAN-1 --summary 'Add export: CSV'
stdout '^PROJ-9: stub note written, covered by MAN-1$'
grep '^title: PROJ-9$' home/Documents/Obsidian/demo/tickets/jira/PROJ-9/PROJ-9.md
grep '^summary: "Add export: CSV"$' home/Documents/Obsidian/demo/tickets/jira/PROJ-9/PROJ-9.md
grep '^source: jira$' home/Documents/Obsidian/demo/tickets/jira/PROJ-9/PROJ-9.md
grep '^source-id: PROJ-9$' home/Documents/Obsidian/demo/tickets/jira/PROJ-9/PROJ-9.md
grep '^covered-by: "\[\[MAN-1\]\]"$' home/Documents/Obsidian/demo/tickets/jira/PROJ-9/PROJ-9.md
grep '^tags: \[ticket, jira, proj\]$' home/Documents/Obsidian/demo/tickets/jira/PROJ-9/PROJ-9.md
grep '^<!-- source:start -->$' home/Documents/Obsidian/demo/tickets/jira/PROJ-9/PROJ-9.md
grep '^covers: \["\[\[PROJ-2\]\]", "\[\[PROJ-9\]\]"\]$' home/Documents/Obsidian/demo/tickets/manual/MAN-1/MAN-1.md

# not twice
! exec ct ticket stub PROJ-9 --source jira --covered-by MAN-1 --summary again
stderr 'already has a note'
grep '^covers: \["\[\[PROJ-2\]\]", "\[\[PROJ-9\]\]"\]$' home/Documents/Obsidian/demo/tickets/manual/MAN-1/MAN-1.md
! exists home/Documents/Obsidian/demo/.vault.lock.d

# a closed lead is refused; a non-epic lead is warned about
! exec ct ticket stub PROJ-8 --source jira --covered-by MAN-2 --summary x
stderr 'MAN-2 is closed'
! exists home/Documents/Obsidian/demo/tickets/jira/PROJ-8
exec ct ticket stub PROJ-8 --source jira --covered-by MAN-1 --summary y
stdout 'warning: MAN-1 is not an epic'

# a synced (source epic) lead: only the child's covered-by is written
exec ct ticket stub PROJ-7 --source jira --covered-by PROJ-3 --summary z
stdout 'PROJ-3 is synced from jira: its covers are left to the source'
grep '^covered-by: "\[\[PROJ-3\]\]"$' home/Documents/Obsidian/demo/tickets/jira/PROJ-7/PROJ-7.md
! grep 'PROJ-7' home/Documents/Obsidian/demo/tickets/jira/PROJ-3/PROJ-3.md

-- sources.json --
{"sources": {
  "manual": {"enabled": true, "sync": false, "idPrefix": "MAN"},
  "jira": {"enabled": true, "mcp": "atlassian", "idPrefix": ""}}}
-- man-2.md --
---
title: MAN-2
status: closed
source: manual
covers: []
tags: [ticket]
---
# MAN-2
-- man-1.md --
---
title: MAN-1
status: new
source: manual
covers: ["[[PROJ-2]]"]
tags: [ticket]
---
# MAN-1
-- proj-3.md --
---
title: PROJ-3
source: jira
source-id: PROJ-3
tags: [ticket, jira, proj]
---
# PROJ-3

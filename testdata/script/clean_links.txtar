# ct clean: link rewriting edge cases (aliases, headings, blocks, embeds, path forms, code, CRLF, BOM, frontmatter forms, sync-owned places)
env V=home/Documents/Obsidian/a
mkdir $V/.obsidian $V/tickets/PROJ-12 $V/tickets/PROJ-120 $V/tickets/PROJ-1 $V/tickets/MAN-5 $V/tickets/PROJ-40 $V/templates $V/notes
cp proj-12.md $V/tickets/PROJ-12/PROJ-12.md
cp open.md $V/tickets/PROJ-120/PROJ-120.md
cp open.md $V/tickets/PROJ-1/PROJ-1.md
cp man-5.md $V/tickets/MAN-5/MAN-5.md
cp proj-40.md $V/tickets/PROJ-40/PROJ-40.md
cp body.md $V/notes/body.md
cp tpl.md $V/templates/tpl.md
cp fm.md $V/notes/fm.md
cp empty $V/pending.md
cp empty $V/tickets.base
exec sh -c 'printf -- "---\r\ntitle: crlf\r\n---\r\nSee [[PROJ-12]].\r\n" > home/Documents/Obsidian/a/notes/crlf.md'
exec sh -c 'printf "\357\273\277---\nrelated: [\"[[PROJ-12]]\"]\n---\nBOM [[PROJ-12]]\n" > home/Documents/Obsidian/a/notes/bom.md'
exec ct clean --yes
stdout 'PROJ-12: moved to .trash/PROJ-12; rewrote'
stdout 'warning: notes/fm.md:9 still links \[\[PROJ-12\]\]'
exec cat $V/notes/body.md
cmp $V/notes/body.md body-after.md
cmp $V/templates/tpl.md tpl.md
cmp $V/notes/fm.md fm-after.md
cmp $V/tickets/MAN-5/MAN-5.md man-5-after.md
cmp $V/tickets/PROJ-40/PROJ-40.md proj-40-after.md
exec sh -c 'od -c home/Documents/Obsidian/a/notes/crlf.md | head -3'
stdout '\\r'
grep 'See \[PROJ-12\]\(https://x.example/browse/PROJ-12\)\.' $V/notes/crlf.md
grep 'BOM \[PROJ-12\]' $V/notes/bom.md
grep 'related: \["\[PROJ-12\]' $V/notes/bom.md
exec sh -c 'cat home/Documents/Obsidian/a/inbox/*-ct-clean-follow-ups.md'
stdout 'notes/fm.md:9 still links PROJ-12 \(removed by ct clean\) in a frontmatter form it can.t rewrite'
! exec ct vault links check $V
stdout -count=1 'unresolved link'
stdout 'notes/fm.md:9: unresolved link \[\[PROJ-12\]\]'
stdout '3 link\(s\) in sync-owned parts'


# ct ws diff-check: binary or large files added by any commit of a range
expand gitconfig
exec git init -q -b main repo
exec git -C repo add -A
exec git -C repo commit -q -m init
exec git -C repo checkout -q -b topic

# a text change only: clean
cp note.txt repo/note.txt
exec git -C repo add note.txt
exec git -C repo commit -q -m note
exec ct ws diff-check -C repo main..topic
! stdout .
! stderr .

# a binary added, then deleted: still flagged
# written by printf: a NUL in this file would make it binary itself
exec sh -c 'printf "bin\\000data\\n" > repo/blob.bin'
exec git -C repo add blob.bin
exec git -C repo commit -q -m blob
rm repo/blob.bin
exec git -C repo commit -q -am drop
! exec ct ws diff-check -C repo main..topic
stdout '^binary\t[0-9]+\t[0-9a-f]+\tblob.bin$'
stderr '1 file\(s\) flagged'

# a size over the limit
! exec ct ws diff-check -C repo --max-size 4 main~0..topic~2
stdout '^large\t[0-9]+\t[0-9a-f]+\tnote.txt$'

# a bad range
! exec ct ws diff-check -C repo nosuch..topic
stderr .

# a range that looks like an option is a usage error
! exec ct ws diff-check -C repo --max-size 1M -- --all
stderr 'bad range'
! stdout .

-- note.txt --
some text that is longer than four bytes
-- gitconfig --
[user]
	name = Jane Doe
	email = jane@example.com
-- repo/README.md --
acme

# tix vault note: write rules (workspace, protected parts, epic covers, no workspace, --save, vault lock)
mkdir v/.obsidian v/inbox v/projects/acme v/raw v/tickets/PROJ-1 v/tickets/PROJ-2
cp epic.md v/tickets/PROJ-1/PROJ-1.md
cp child.md v/tickets/PROJ-2/PROJ-2.md
cp scratch.md v/tickets/PROJ-1/scratch.md
cp scratch.md v/projects/acme/a.md
cp scratch.md v/inbox/i.md
cp scratch.md v/raw/r.md
env TIX_VAULT=$WORK/v
mkdir ws1/sub
cp ws1.json ws1/workspace.json

# a ticket workspace (PROJ-1, an epic covering PROJ-2): its own folder is writable
cd ws1/sub
exec tix vault note append scratch.md Log --file ../../add.txt
stdout 'wrote tickets/PROJ-1/scratch.md'
grep '^added$' ../../v/tickets/PROJ-1/scratch.md
exec tix vault note frontmatter PROJ-1 status --set doing
exec tix vault note set-section PROJ-1 Tasks --file ../../add.txt

# a task agent writes its task file's ## Report from its worktree (as
# task-agent tells it): only that section changes, a ## Report quoted in a
# fence stays, and the rest of the file is byte for byte what it was
mkdir ../../v/tickets/PROJ-1/tasks ../tasks/acme-01
cp ../../task.md ../../v/tickets/PROJ-1/tasks/PROJ-1-01-retry.md
cd ../tasks/acme-01
stdin ../../../report.txt
exec tix vault note set-section PROJ-1-01-retry '## Report'
stdout 'wrote tickets/PROJ-1/tasks/PROJ-1-01-retry.md'
cmp ../../../v/tickets/PROJ-1/tasks/PROJ-1-01-retry.md ../../../task_after.md
cd ../../sub
# other folders are refused (exit 3) and left alone
! exec tix vault note append projects/acme/a.md Log --file ../../add.txt
stderr 'tix vault note: refusing to write projects/acme/a.md: a ticket.s agents write only inside tickets/PROJ-1/ until /tix:save \(AGENTS.md, "Who writes what" 3\); /tix:save passes --save'
exec sh ../../code.sh tix vault note append projects/acme/a.md Log --file ../../add.txt
stdout '^code=3$'
! grep '^added$' ../../v/projects/acme/a.md
! exists ../../v/.vault.lock.d

# protected fields and sections of the ticket note
exec sh ../../code.sh tix vault note frontmatter PROJ-1 title --set Other
stdout '^code=3$'
exec sh ../../code.sh tix vault note frontmatter PROJ-1 source-url --set x
stdout '^code=3$'
exec sh ../../code.sh tix vault note frontmatter PROJ-1 covers --add '[[PROJ-9]]'
stdout '^code=3$'
! exec tix vault note set-section PROJ-1 Description --file ../../add.txt
stderr 'refusing to write section "Epic > Description"'
exec sh ../../code.sh tix vault note set-section PROJ-1 'Acceptance criteria' --file ../../add.txt
stdout '^code=3$'
exec sh ../../code.sh tix vault note append PROJ-1 'Context / links' --file ../../add.txt
stdout '^code=3$'
exec sh ../../code.sh tix vault note append PROJ-1 Description --create 2 --file ../../add.txt
stdout '^code=3$'

exec cp ../../v/tickets/PROJ-1/PROJ-1.md ../../snap.md
# the write, not its named target, is what the rules check
exec sh ../../code.sh tix vault note set-section PROJ-1 Epic --with-subsections --file ../../add.txt
stdout '^code=3$'
cmp ../../v/tickets/PROJ-1/PROJ-1.md ../../snap.md
exec sh ../../nlkey.sh
stdout '^code=2$'
cmp ../../v/tickets/PROJ-1/PROJ-1.md ../../snap.md
exec sh ../../code.sh tix vault note append PROJ-1 Tasks --file ../../dupdesc.txt
stdout '^code=3$'
cmp ../../v/tickets/PROJ-1/PROJ-1.md ../../snap.md

# the epic writes the work sections and status of the tickets it covers, nothing else
exec tix vault note set-section PROJ-2 Tasks --file ../../add.txt
exec tix vault note frontmatter PROJ-2 status --set doing
grep '^status: doing$' ../../v/tickets/PROJ-2/PROJ-2.md
exec sh ../../code.sh tix vault note set-section PROJ-2 Notes --file ../../add.txt
stdout '^code=3$'
exec sh ../../code.sh tix vault note frontmatter PROJ-2 title --set x
stdout '^code=3$'
exec sh ../../code.sh tix vault note frontmatter PROJ-2 tags --add x
stdout '^code=3$'
exec sh ../../code.sh tix vault note set-section PROJ-2 Description --file ../../add.txt
stdout '^code=3$'
cmp ../../v/tickets/PROJ-2/PROJ-2.md ../../child_after.md

# a ticket that isn't an epic can't write its sibling
cd $WORK
mkdir ws2
cp ws2.json ws2/workspace.json
cd ws2
exec sh ../code.sh tix vault note set-section PROJ-1 Tasks --file ../add.txt
stdout '^code=3$'
exec tix vault note set-section PROJ-2 Notes --file ../add.txt

# a manual ticket's own workspace writes its content sections; a synced one never
cd $WORK
mkdir v/tickets/PROJ-3 v/tickets/PROJ-4 ws3 ws4
cp man.md v/tickets/PROJ-3/PROJ-3.md
cp syn.md v/tickets/PROJ-4/PROJ-4.md
cp ws3.json ws3/workspace.json
cp ws4.json ws4/workspace.json
cd ws3
exec tix vault note set-section PROJ-3 Description --file ../add.txt
exec tix vault note append PROJ-3 'Acceptance criteria' --file ../add.txt
grep '^added$' ../v/tickets/PROJ-3/PROJ-3.md
exec sh ../code.sh tix vault note frontmatter PROJ-3 source --set jira
stdout '^code=3$'
cd ../ws4
! exec tix vault note set-section PROJ-4 Description --file ../add.txt
stderr 'source is not manual \(source: jira\)'
! exec tix vault note set-section PROJ-4 'Source (Jira)' --file ../add.txt
stderr 'source block'

# no workspace: inbox only
cd $WORK
exec tix vault note append inbox/i.md Log --file add.txt
exec sh code.sh tix vault note append projects/acme/a.md Log --file add.txt
stdout '^code=3$'
! exec tix vault note append projects/acme/a.md Log --file add.txt
stderr 'only inside inbox/ until /tix:save'
exec sh code.sh tix vault note append scratch.md Log --file add.txt
stdout '^code=3$'

# --save: the shared notes, not raw/ or a ticket note's protected parts
exec tix vault note append projects/acme/a.md Log --save --file add.txt
grep '^added$' v/projects/acme/a.md
exec sh code.sh tix vault note append raw/r.md Log --save --file add.txt
stdout '^code=3$'
exec sh code.sh tix vault note frontmatter PROJ-2 title --set x --save
stdout '^code=3$'
exec sh code.sh tix vault note set-section PROJ-2 Description --save --file add.txt
stdout '^code=3$'
exec tix vault note frontmatter PROJ-2 status --set done --save
exec tix vault note frontmatter PROJ-2 tags --add t --save
grep '^tags: \[t\]$' v/tickets/PROJ-2/PROJ-2.md

# the vault lock: taken for a write and released; one already held by the same owner is used and kept
! exists v/.vault.lock.d
exec tix vault lock acquire v me
exec tix vault note append inbox/i.md Log --owner me --file add.txt
exec tix vault lock status v
stdout '^locked by .me.$'
exec tix vault lock release v me
env TIX_LOCK_OWNER=envowner
exec tix vault lock acquire v envowner
exec tix vault note append inbox/i.md Log --file add.txt
exec tix vault lock status v
stdout '^locked by .envowner.$'
exec tix vault lock release v envowner
! exists v/.vault.lock.d

-- epic.md --
---
title: Epic
ticket-type: epic
covers: ["[[PROJ-2]]"]
status: open
---
# Epic

## Description

d

## Acceptance criteria

ac

## Context / links

c

## Tasks

t
-- child.md --
---
title: Child
status: open
---
# Child

## Description

d

## Acceptance criteria

ac

## Context / links

c

## Tasks

t

## Notes

n
-- child_after.md --
---
title: Child
status: doing
---
# Child

## Description

d

## Acceptance criteria

ac

## Context / links

c

## Tasks

added

## Notes

n
-- man.md --
---
title: Man
source: manual
status: open
---
# Man

## Description

d

## Acceptance criteria

a
-- syn.md --
---
title: Syn
source: jira
status: open
---
# Syn

## Description

d

## Source (Jira)

<!-- source:start -->
s
<!-- source:end -->
-- ws3.json --
{"id": "PROJ-3", "repos": []}
-- ws4.json --
{"id": "PROJ-4", "repos": []}
-- scratch.md --
# Scratch

## Log

first
-- add.txt --
added
-- ws1.json --
{"id": "PROJ-1", "repos": []}
-- ws2.json --
{"id": "PROJ-2", "repos": []}
-- code.sh --
"$@" >/dev/null 2>&1
echo "code=$?"
-- dupdesc.txt --
## Description

x
-- nlkey.sh --
k=$(printf 'status: x\ntitle')
tix vault note frontmatter PROJ-1 "$k" --set hacked >/dev/null 2>&1
echo "code=$?"
-- task.md --
---
id: 01
ticket: "[[PROJ-1]]"
---
## Goal
Retry the upload.

## Do
- Write it as in this sample:
```
## Report
not the heading
```

## Checks
- make check

## Report
<!-- Written by the task agent -->
-- report.txt --
Task 01: done
Commits: abc1234 feat(upload): retry
-- task_after.md --
---
id: 01
ticket: "[[PROJ-1]]"
---
## Goal
Retry the upload.

## Do
- Write it as in this sample:
```
## Report
not the heading
```

## Checks
- make check

## Report
Task 01: done
Commits: abc1234 feat(upload): retry

# tix ws diff-check: informational notes for changed tests and unsigned commits
expand gitconfig
exec git init -q -b main repo
exec git -C repo add -A
exec git -C repo commit -q -m init
exec git -C repo checkout -q -b topic

# a changed existing test and an existing script test: noted, exit 0
cp a_test_v2.go repo/a_test.go
cp s_v2.txtar repo/testdata/s.txtar
exec git -C repo add -A
exec git -C repo commit -q -m change
exec tix ws diff-check -C repo main..topic
stdout '^note\ttest-changed\tTestOne\t[0-9a-f]+\ta_test.go$'
stdout '^note\ttest-changed\t-\t[0-9a-f]+\ttestdata/s.txtar$'
! stdout unsigned
! stderr .

# gpgsign on: the unsigned commit is noted, still exit 0
exec git -C repo config commit.gpgsign true
exec tix ws diff-check -C repo main..topic
stdout '^note\tunsigned\t-\t[0-9a-f]+\t:commit$'
! stderr .

-- a_test_v2.go --
package a

import "testing"

func TestOne(t *testing.T) { t.Log(2) }
-- s_v2.txtar --
two
-- gitconfig --
[user]
	name = Jane Doe
	email = jane@example.com
-- repo/a_test.go --
package a

import "testing"

func TestOne(t *testing.T) { t.Log(1) }
-- repo/testdata/s.txtar --
one

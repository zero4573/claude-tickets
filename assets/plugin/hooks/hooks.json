{
  "hooks": {
    "Notification": [
      { "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [{ "type": "command", "command": "ct hook agent-state needs-input" }] }
    ],
    "PreToolUse": [
      { "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "ct hook agent-state needs-input" }] }
    ],
    "PostToolUse": [
      { "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "ct hook agent-state working" }] }
    ],
    "UserPromptSubmit": [
      { "matcher": "",
        "hooks": [{ "type": "command", "command": "ct hook agent-state working" }] }
    ],
    "Stop": [
      { "matcher": "",
        "hooks": [{ "type": "command", "command": "ct hook agent-state idle" }] }
    ],
    "SessionEnd": [
      { "matcher": "",
        "hooks": [{ "type": "command", "command": "ct hook agent-state exited" }] }
    ]
  }
}

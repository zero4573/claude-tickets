#!/usr/bin/env bash
# Records what a ticket or kb session is doing in <workspace>/.agent-state,
# for ticket-status: agent-state <state>, with the hook's JSON payload on
# stdin. The workspace is the nearest folder at or above the session's cwd
# whose workspace.json has an id; outside one this does nothing. needs-input
# from an AskUserQuestion also desktop-notifies (when notify-send exists),
# since a question doesn't raise a Notification hook of its own.
# (The Nix package puts jq, coreutils and notify-send on PATH here.)
set -euo pipefail
#@PATH@

find_workspace() {
  local d="$1"
  while [[ -n "$d" && "$d" != / ]]; do
    if jq -e '.id' "$d/workspace.json" >/dev/null 2>&1; then
      echo "$d"
      return 0
    fi
    d="$(dirname "$d")"
  done
  return 1
}

state="$1"
input="$(cat)"
cwd="$(jq -r '.cwd // empty' <<<"$input" 2>/dev/null || true)"
[[ -n "$cwd" ]] || exit 0
dir="$(find_workspace "$cwd")" || exit 0
key="$(jq -r .id "$dir/workspace.json")"
reason=""
if [[ "$state" == needs-input ]]; then
  reason="$(jq -r '.tool_input.questions[0].question // .message // "needs input"' <<<"$input" 2>/dev/null || echo "needs input")"
fi
jq -n --arg s "$state" --arg r "$reason" --arg ts "$(date -Iseconds)" \
  '{state: $s, reason: $r, ts: $ts}' > "$dir/.agent-state.tmp"
mv "$dir/.agent-state.tmp" "$dir/.agent-state"
if [[ "$state" == needs-input && "$(jq -r '.hook_event_name // empty' <<<"$input")" == PreToolUse ]] \
   && command -v notify-send >/dev/null 2>&1; then
  notify-send -a "Claude Code" "Claude Code ($key): question" "$reason" || true
fi
